<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="@bool/fit_system_windows"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/RootLayoutPadding">

    <LinearLayout
        android:fitsSystemWindows="@bool/fit_system_windows"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- devices -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_general_Input"/>

        <Spinner
            android:id="@+id/input_devices_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_general_Output"/>

        <Spinner
            android:id="@+id/output_devices_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Channel Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_loopback_calibrate_channel"/>

        <Spinner
            android:id="@+id/audio_calibration_channel_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Player Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            style="?android:attr/buttonBarStyle"
            android:id="@+id/audio_calibration_process">
            <Button
                android:text="@string/audio_general_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/audio_calibration_start"
                style="?android:attr/buttonBarButtonStyle"/>
            <Button
                android:text="@string/audio_general_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/audio_calibration_stop"
                style="?android:attr/buttonBarButtonStyle"/>
            <Button
                android:text="@string/audio_general_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/audio_calibration_done"
                style="?android:attr/buttonBarButtonStyle"/>
        </LinearLayout>

        <com.android.cts.verifier.audio.audiolib.WaveScopeView
            android:id="@+id/uap_recordWaveView"
            android:layout_width="match_parent"
            android:layout_height="200dp"/>

        <TextView
            android:id="@+id/audio_calibration_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="5dp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="5dp"
            android:id="@+id/audio_calibration_info">

        </LinearLayout>

    </LinearLayout>
</ScrollView>
