<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="@bool/fit_system_windows"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/scrollView"
    style="@style/RootLayoutPadding">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="10dip"
        android:paddingRight="10dip">

        <TextView
            android:id="@+id/audio_playback_params_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dip"/>

        <LinearLayout
            android:id="@+id/audio_playback_params_layout"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/audio_playback_params_button_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/audio_playback_params_test"/>

            <ProgressBar
                android:id="@+id/audio_playback_params_progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="?android:attr/progressBarStyleSmall"/>

            <TextView
                android:id="@+id/audio_playback_params_test_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/audio_playback_params_analysis_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/audio_playback_params_button_play_original"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Play Original"/>
                <Button
                    android:id="@+id/audio_playback_params_button_play_rec1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Play Recording 1"/>
                <Button
                    android:id="@+id/audio_playback_params_button_play_rec2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Play Recording 2"/>

            </LinearLayout>

        </LinearLayout>

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            layout="@layout/pass_fail_buttons" />
    </LinearLayout>
</ScrollView>
