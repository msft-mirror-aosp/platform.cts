<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/RootLayoutPadding"
    android:fitsSystemWindows="@bool/fit_system_windows"
    android:layout_height="match_parent"
    android:layout_width="match_parent">
    <LinearLayout
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:orientation="vertical">
        <TableLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:stretchColumns="1">
            <TableRow>
                <TextView android:text="@string/audio_workload_mpc" />
                <TextView android:id="@+id/audio_workload_mpc" />
            </TableRow>
        </TableLayout>
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="horizontal">
            <Button
                android:id="@+id/button_start"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:onClick="startTest"
                android:text="@string/audio_workload_start_audio" />
            <Button
                android:id="@+id/button_stop"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:onClick="stopTest"
                android:text="@string/audio_workload_stop_audio" />
        </LinearLayout>
        <TextView
            android:id="@+id/stream_info_view"
            style="@style/InstructionsSmallFont"
            android:fontFamily="monospace"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:lines="2"
            android:text="Tap START to start the test" />
        <TextView
            android:id="@+id/current_status_view"
            style="@style/InstructionsSmallFont"
            android:fontFamily="monospace"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:lines="2"
            android:text="Results:" />
        <com.android.cts.verifier.audio.audiolib.MultiLineChart
            android:id="@+id/multiline_chart"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:minHeight="100dp" />
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/max_voices_reached_view"
                style="@style/InstructionsSmallFont"
                android:fontFamily="monospace"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/audio_workload_max_voices_reached" />
            <TextView
                android:id="@+id/max_voices_reached_value_view"
                style="@style/InstructionsSmallFont"
                android:fontFamily="monospace"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="N/A" />
        </LinearLayout>
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:orientation="horizontal">
            <TextView android:id="@+id/min_voices_required_view"
                style="@style/InstructionsSmallFont"
                android:fontFamily="monospace"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/audio_workload_min_voices_required" />
            <TextView
                android:id="@+id/min_voices_required_value_view"
                style="@style/InstructionsSmallFont"
                android:fontFamily="monospace"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="N/A" />
        </LinearLayout>
        <TextView
            android:id="@+id/info_message"
            style="@style/InstructionsSmallFont"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:padding="10dp"
            android:text="@string/audio_workload_instructions" />
        <include layout="@layout/pass_fail_buttons" />
    </LinearLayout>
</ScrollView>
