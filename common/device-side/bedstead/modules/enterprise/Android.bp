package {
    default_team: "trendy_team_enterprise",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_library {
    name: "bedstead-enterprise",
    srcs: [
        "src/main/kotlin/**/*.kt",
        "src/main/kotlin/**/*.java",
        ":bedstead-accounts-harrier-temporary-srcs",
    ],
    manifest: "src/main/AndroidManifest.xml",
    sdk_version: "system_current",
    min_sdk_version: "29",
    static_libs: [
        "bedstead-testapps",
        "RemoteAccountAuthenticator",
    ],
    plugins: ["auto_annotation_plugin"],
}

android_test {
    name: "bedstead-enterprise-test",
    srcs: [
        "src/test/kotlin/**/*.kt",
        "src/test/kotlin/**/*.java",
    ],
    test_suites: [
        "general-tests",
    ],
    static_libs: [
        "bedstead-enterprise",
        "truth",
        "bedstead-root",
    ],
    manifest: "src/test/AndroidManifest.xml",
    min_sdk_version: "29",
    sdk_version: "system_current",
}
