<configuration description="Settings specific for CTS-V-HOST interactive tests">
    <result_reporter class="com.android.compatibility.common.tradefed.result.suite.InteractiveResultReporter" />

    <!-- In case any interactive module doesn't configure it at module level. -->
    <option name="compatibility:test-arg" value="com.android.tradefed.testtype.AndroidJUnitTest:include-annotation:com.android.interactive.annotations.Interactive" />
    <option name="compatibility:test-arg" value="com.android.tradefed.testtype.HostTest:include-annotation:com.android.interactive.annotations.Interactive" />
    <option name="compatibility:test-arg" value="com.android.compatibility.common.tradefed.testtype.JarHostTest:include-annotation:com.android.interactive.annotations.Interactive" />

    <!-- By default ENABLE_MANUAL is false, set it as true for modules that need a manual test as fallback.-->
    <option name="compatibility:module-arg" value="CtsSysuiInteractiveTestCases:instrumentation-arg:ENABLE_MANUAL:=true" />
</configuration>
