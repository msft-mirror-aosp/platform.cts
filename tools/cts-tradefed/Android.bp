package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library_host {
    name: "cts-tradefed-harness",

    java_resource_dirs: ["res"],
    libs: [
        "tradefed",
        "compatibility-host-util",
    ],
    static_libs: [
        "compatibility-tradefed",
    ],
}

tradefed_binary_host {
    name: "cts-tradefed",
    wrapper: "etc/cts-tradefed",
    short_name: "CTS",
    full_name: "Compatibility Test Suite",
    version: "16.1_r1",
    static_libs: ["cts-tradefed-harness"],
    required: ["compatibility-host-util"],
}

compatibility_test_suite_package {
    name: "cts",
    tradefed: "cts-tradefed",
    dynamic_config: "DynamicConfig.xml",
    readme: "README",
    tools: [
        "ats_console_deploy",
        "ats_olc_server_local_mode_deploy",
    ],
    build_test_list: true,
    build_metadata: true,
}
