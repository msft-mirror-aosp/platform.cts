<configuration description="Runs a subset of CTS tests to certify Software Defined Vehicle (SDV) Platform.">
     <!-- The unique name of the test plan. -->
    <option name="plan" value="cts-sdv" />
    <!-- `everything.xml` includes all the TF configurations required for the plan execution. -->
    <include name="everything" />
    <!-- Excludes all the known failures and deprecated CTS tets. -->
    <include name="cts-exclude" />
    <!-- Verbose logs. -->
    <option name="log-level" value="verbose" />

    <!--
    SDV Platform tests.
    Sorted in the alphabetical order.
    -->

    <!-- go/keep-sorted start -->
    <option name="compatibility:include-filter" value="CtsAdbHostTestCases" />
    <option name="compatibility:include-filter" value="CtsApexTestCases" />
    <option name="compatibility:include-filter" value="CtsAslrMallocTestCases" />
    <option name="compatibility:include-filter" value="CtsFsMgrTestCases" />
    <option name="compatibility:include-filter" value="CtsKernelConfigTestCases" />
    <option name="compatibility:include-filter" value="CtsLiblogTestCases" />
    <option name="compatibility:include-filter" value="CtsLogdTestCases" />
    <!-- go/keep-sorted end -->
</configuration>
