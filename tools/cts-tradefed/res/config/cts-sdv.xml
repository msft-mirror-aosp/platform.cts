<configuration description="Runs a subset of CTS tests to certify Software Defined Vehicle (SDV) Platform.">
     <!-- The unique name of the test plan. -->
    <option name="plan" value="cts-sdv" />
    <!-- `everything.xml` includes all the TF configurations required for the plan execution. -->
    <include name="everything" />
    <!-- Excludes all the known failures and deprecated CTS tets. -->
    <include name="cts-exclude" />
    <!-- Verbose logs. -->
    <option name="log-level" value="verbose" />

    <!--
    SDV Platform tests.
    Sorted in the alphabetical order.
    -->

    <!-- go/keep-sorted start -->
    <option name="compatibility:include-filter" value="CtsAdbHostTestCases" />
    <option name="compatibility:include-filter" value="CtsApexTestCases" />
    <option name="compatibility:include-filter" value="CtsAslrMallocTestCases" />
    <option name="compatibility:include-filter" value="CtsBionicTestCases" />
    <option name="compatibility:include-filter" value="CtsEdiHostTestCases" />
    <option name="compatibility:include-filter" value="CtsFsMgrTestCases" />
    <option name="compatibility:include-filter" value="CtsKernelConfigTestCases" />
    <option name="compatibility:include-filter" value="CtsLiblogTestCases" />
    <option name="compatibility:include-filter" value="CtsLogdTestCases" />
    <!-- go/keep-sorted end -->

    <!-- TODO(b/431119128): Investigate the Bionic tests failure and restore them for SDV. -->
    <option name="compatibility:exclude-filter" value="CtsBionicTestCases netdb#*" />
    <option name="compatibility:exclude-filter" value="CtsBionicTestCases stdio_nofortify#dev_std_files" />
    <option name="compatibility:exclude-filter" value="CtsBionicTestCases stdio#dev_std_files" />
    <option name="compatibility:exclude-filter" value="CtsBionicTestCases unistd#exec_argv0_null" />
    <option name="compatibility:exclude-filter" value="CtsBionicTestCases time#tzalloc_nullptr" />
    <option name="compatibility:exclude-filter" value="CtsBionicTestCases unistd_nofortify#exec_argv0_null" />
    <option name="compatibility:exclude-filter" value="CtsBionicTestCases unistd_nofortify#lockf_zero" />
    <option name="compatibility:exclude-filter" value="CtsBionicTestCases dlext#ns_exempt_list_enabled" />

    <!-- TODO(b/431206638): Investigate the Executor Device Interactions tests failure and restore them for SDV. -->
    <option name="compatibility:exclude-filter" value="CtsEdiHostTestCases android.edi.cts.DynamicPartitionsDeviceInfo#testCollectDeviceInfo" />
    <option name="compatibility:exclude-filter" value="CtsEdiHostTestCases android.edi.cts.StorageIoInterfaceDeviceInfo#testCollectDeviceInfo" />
    <option name="compatibility:exclude-filter" value="CtsEdiHostTestCases android.edi.cts.VbmetaDeviceInfo#testCollectDeviceInfo" />
</configuration>
