<configuration description="Runs CTS on user-signed builds">
    <include name="cts" />

    <option name="plan" value="cts-restricted-build" />

    <!-- Tell all runners to include tests annotated with @RestrictedBuildTest -->
    <option name="compatibility:test-arg" value="com.android.tradefed.testtype.AndroidJUnitTest:include-annotation:android.platform.test.annotations.RestrictedBuildTest" />
    <option name="compatibility:test-arg" value="com.android.tradefed.testtype.HostTest:include-annotation:android.platform.test.annotations.RestrictedBuildTest" />
    <option name="compatibility:test-arg" value="com.android.compatibility.common.tradefed.testtype.JarHostTest:include-annotation:android.platform.test.annotations.RestrictedBuildTest" />


    <!-- Modules That have any test annotated with @RestrictedBuildTest -->
    <option name="compatibility:include-filter" value="CtsAppSecurityHostTestCases" />
    <option name="compatibility:include-filter" value="CtsAppSecurityHostTestCases[secondary_user]" />
    <option name="compatibility:include-filter" value="CtsAppTestCases" />
    <option name="compatibility:include-filter" value="CtsAppTestCases[instant]" />
    <option name="compatibility:include-filter" value="CtsAppTestCases[run-on-sdk-sandbox]" />
    <option name="compatibility:include-filter" value="CtsAppTestCases[secondary_user]" />
    <option name="compatibility:include-filter" value="CtsAppTestCases[secondary_user_on_secondary_display]" />
    <option name="compatibility:include-filter" value="CtsDpiTestCases" />
    <option name="compatibility:include-filter" value="CtsDpiTestCases[instant]" />
    <option name="compatibility:include-filter" value="CtsDpiTestCases[run-on-sdk-sandbox]" />
    <option name="compatibility:include-filter" value="CtsDpiTestCases[secondary_user]" />
    <option name="compatibility:include-filter" value="CtsDpiTestCases[secondary_user_on_secondary_display]" />
    <option name="compatibility:include-filter" value="CtsKeystoreTestCases" />
    <option name="compatibility:include-filter" value="CtsKeystoreTestCases[run-on-sdk-sandbox]" />
    <option name="compatibility:include-filter" value="CtsKeystoreTestCases[secondary_user]" />
    <option name="compatibility:include-filter" value="CtsKeystoreTestCases[secondary_user_on_secondary_display]" />
    <option name="compatibility:include-filter" value="CtsOsHostTestCases" />
    <option name="compatibility:include-filter" value="CtsOsHostTestCases[instant]" />
    <option name="compatibility:include-filter" value="CtsOsHostTestCases[secondary_user]" />
    <option name="compatibility:include-filter" value="CtsOsTestCases" />
    <option name="compatibility:include-filter" value="CtsOsTestCases[instant]" />
    <option name="compatibility:include-filter" value="CtsOsTestCases[run-on-sdk-sandbox]" />
    <option name="compatibility:include-filter" value="CtsOsTestCases[run-on-work-profile]" />
    <option name="compatibility:include-filter" value="CtsOsTestCases[secondary_user]" />
    <option name="compatibility:include-filter" value="CtsSecurityHostTestCases" />
    <option name="compatibility:include-filter" value="CtsSecurityHostTestCases[secondary_user]" />
    <option name="compatibility:include-filter" value="CtsSecurityTestCases" />
    <option name="compatibility:include-filter" value="CtsSecurityTestCases[run-on-sdk-sandbox]" />
    <option name="compatibility:include-filter" value="CtsSecurityTestCases[secondary_user]" />
    <option name="compatibility:include-filter" value="CtsSecurityTestCases[secondary_user_on_secondary_display]" />
</configuration>
