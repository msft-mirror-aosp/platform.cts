package {
    default_team: "trendy_team_enterprise",
}

java_binary_host {
    name: "cts-policy-tests-generator",
    main_class: "com.android.cts.policytestsgenerator.MainKt",
    static_libs: ["CtsPolicyTestsGeneratorLibrary"],
}

java_library_host {
    name: "CtsPolicyTestsGeneratorLibrary",
    srcs: [
        "src/**/*.kt",
    ],
    static_libs: [
        "DevicePolicyAnnotationProcessorHostLibrary",
        "guava",
        "libprotobuf-java-full",
    ],
}

java_test_host {
    name: "CtsPolicyTestsGeneratorTests",
    srcs: [
        "javatests/**/*.kt",
    ],
    static_libs: [
        "CtsPolicyTestsGeneratorLibrary",
        "junit",
        "junit-params",
        "kotlin-stdlib",
        "kotlin-test",
        "mockito",
        "truth",
    ],
}
