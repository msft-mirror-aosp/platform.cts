package {
    default_team: "trendy_team_motion",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test {
    name: "CtsMultisensoryTestCases",
    defaults: ["cts_defaults"],
    compile_multilib: "both",
    static_libs: [
        "androidx.test.ext.junit",
        "ctstestrunner-axt",
        "flag-junit",
        "truth",
        "guava",
        "junit",
        "android.os.multisensory.flags-aconfig-java",
    ],
    srcs: [
        "src/**/*.java",
    ],
    manifest: "AndroidManifest.xml",
    // Set its own test config to prevent sharing with cts-platform-version-check
    test_config: "AndroidTest.xml",
    // Tag this module as a cts test artifact
    test_suites: [
        "cts",
        "general-tests",
    ],
    sdk_version: "test_current",
    libs: [
        "android.test.runner.stubs.test",
        "android.test.base.stubs.test",
    ],
    min_sdk_version: "29",
    per_testcase_directory: true,
    privileged: true,
}
