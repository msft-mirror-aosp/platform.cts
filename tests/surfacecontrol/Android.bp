package {
    default_team: "trendy_team_windowing_infra_",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "CtsSurfaceControlTests_javalibs",

    libs: [
        "android.test.runner.stubs",
        "android.test.base.stubs",
        "android.view.flags-aconfig-java",
    ],

    static_libs: [
        "androidx.test.rules",
        "androidx.test.ext.junit",
        "android.hardware.flags-aconfig-java",
        "compatibility-device-util-axt",
        "ctsdeviceutillegacy-axt",
        "ctstestrunner-axt",
        "cts-input-lib",
        "cts-hardware-lib",
        "junit-params",
        "mockito-target-minus-junit4",
        "platform-test-annotations",
        "androidx.test.uiautomator_uiautomator",
        "truth",
        "CtsSurfaceValidatorLib",
        "cts-wm-util",
        "CtsMockInputMethodLib",
        "CtsCrossProcessSurfaceControlViewHostTestService",
        "CtsVirtualDeviceCommonLib",
        "flag-junit",
        "com.android.window.flags.window-aconfig-java",
        "hwui_flags_java_lib",
        "ui-trace-collector",
        "collector-device-lib",
        "cts_backported_fixes",
        "surfaceflinger_flags_java_lib",
        "ravenwood-junit",
        "HarrierCommonAndroid",
        "bedstead-enterprise",
    ],
}

android_test {
    name: "CtsSurfaceControlTests",
    defaults: [
        "cts_defaults",
        "CtsSurfaceControlTests_javalibs",
    ],

    // Tag this module as a cts test artifact
    // Adding the test SurfaceFlingerTest to CTS downstreaming to be run in GTS
    test_suites: [
        "cts",
        "gts",
        "general-tests",
    ],

    compile_multilib: "both",

    jni_libs: [
        "libctssurfacecontrol_jni",
        "libnativehelper_compat_libc++",
    ],

    srcs: [
        "src/**/*.java",
        "src/**/*.aidl",
    ],

    data: [
        ":CtsCrossProcessSurfaceControlViewHostTestService",
        ":CtsMockInputMethod",
    ],

    sdk_version: "test_current",
}

android_ravenwood_test {
    name: "CtsSurfaceControlTestsRavenwood",
    auto_gen_config: true,
    defaults: [
        "CtsSurfaceControlTests_javalibs",
    ],

    srcs: [
        "src/android/view/surfacecontrol/cts/ChoreographerTest.java",
        "src/**/*.aidl",
    ],

    sdk_version: "test_current",

    ravenizer: {
        strip_mockito: true,
    },
}
