package {
    default_team: "trendy_team_framework_android_packages",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "cts_package_installer_cuj_defaults",
    defaults: ["cts_defaults"],
    sdk_version: "test_current",

    test_suites: [
        "general-tests",
    ],

    static_libs: [
        "android.content.pm.flags-aconfig-java",
        "androidx.legacy_legacy-support-v4",
        "androidx.test.uiautomator_uiautomator",
        "androidx.test.rules",
        "androidx.test.ext.junit",
        "compatibility-device-util-axt",
        "flag-junit",
        "platform-test-annotations",
        "truth",
    ],

    data: [
        ":CtsEmptyTestApp",
        ":CtsEmptyTestAppV2",
        ":CtsInstallerCujTestApp",
        ":CtsInstallerCujTestAppV2",
        ":CtsInstallerCujTestInstaller",
        ":CtsInstallerCujTestInstallerV2",
        ":CtsInstallerCujTestNoLauncherActivityApp",
        ":CtsInstallerCujTestNoLauncherActivityAppV2",
    ],
    per_testcase_directory: true,
}

genrule_defaults {
    name: "enable_pia_v1_defaults",
    cmd: "sed -e 's/{PIA_CONFIG_VALUE}/0/g' $(in) > $(out)",
}

genrule_defaults {
    name: "enable_pia_v2_defaults",
    cmd: "sed -e 's/{PIA_CONFIG_VALUE}/1/g' $(in) > $(out)",
}

genrule {
    name: "CtsPackageInstallerCUJInstallationTestCases-test-config_v1",
    defaults: ["enable_pia_v1_defaults"],
    out: ["InstallationTestV1.xml"],
    srcs: [
        "InstallationTestTemplate.xml",
    ],
}

genrule {
    name: "CtsPackageInstallerCUJInstallationTestCases-test-config_v2",
    defaults: ["enable_pia_v2_defaults"],
    out: ["InstallationTestV2.xml"],
    srcs: [
        "InstallationTestTemplate.xml",
    ],
}

java_defaults {
    name: "cts_package_installer_cuj_installation_defaults",
    defaults: ["cts_package_installer_cuj_defaults"],
    manifest: "AndroidManifest_installation.xml",
    srcs: [
        "src/android/packageinstaller/criticaluserjourney/cts/InstallationTestBase.java",
        "src/android/packageinstaller/criticaluserjourney/cts/InstallationViaIntentActionViewTest.java",
        "src/android/packageinstaller/criticaluserjourney/cts/InstallationViaIntentTest.java",
        "src/android/packageinstaller/criticaluserjourney/cts/PackageInstallerCujTestBase.java",
    ],
}

android_test {
    name: "CtsPackageInstallerCUJInstallationTestCases",
    defaults: ["cts_package_installer_cuj_installation_defaults"],
    test_config_template: ":CtsPackageInstallerCUJInstallationTestCases-test-config_v1",

    test_suites: [
        "cts",
        "general-tests",
    ],
}

android_test {
    name: "CtsPackageInstallerCUJInstallationTestCasesV2",
    defaults: ["cts_package_installer_cuj_installation_defaults"],
    // Set the value of applicationId (it also applies to package_name) into Manifest.xml
    manifest_values: {
        applicationId: "android.packageinstaller.criticaluserjourney.cts.installation.v2",
    },
    test_config_template: ":CtsPackageInstallerCUJInstallationTestCases-test-config_v2",
}

