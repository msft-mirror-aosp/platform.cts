<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The string resource names here have a suffix indicating if the value has a default value,
      a value behind a flag that is not negated, and a value behind a flag that is negated.

      Thus text101 means there is a default value, no non-negated value, and a negated value.
    -->

    <string name="text110">unflagged</string>
    <string name="text110" android:featureFlag="android.content.res.always_false">plain</string>

    <string name="text101">unflagged</string>
    <string name="text101" android:featureFlag="!android.content.res.always_false">negated</string>

    <string name="text111">unflagged</string>
    <string name="text111" android:featureFlag="android.content.res.always_false">plain</string>
    <string name="text111" android:featureFlag="!android.content.res.always_false">negated</string>

    <string name="text010" android:featureFlag="android.content.res.always_false">plain</string>

    <string name="text001" android:featureFlag="!android.content.res.always_false">negated</string>

    <string name="text011" android:featureFlag="android.content.res.always_false">plain</string>
    <string name="text011" android:featureFlag="!android.content.res.always_false">negated</string>

</resources>