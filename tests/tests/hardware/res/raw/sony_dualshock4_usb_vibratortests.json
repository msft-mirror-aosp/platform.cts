// Refer to kernel dualshock4_send_output_report() in drivers/hid/hid-sony.c (prior to kernel 6.2)
// or to dualshock4_output_worker in drivers/hid/hid-playstation.c (after kernel 6.2)
// In this file, 'dataMaskForAssertions' is needed because depending on the kernel version, driver
// behaviour will differ slightly, which means that we only check some pieces of the output report
// rather that enforce a strict behaviour. As of 2025-10-10, the behavior has changed in kernel
// 6.12. So these checks will have to persist until at least kernel 6.12 is no longer supported.
[
  {
    "id": 1,
    "durations" : [1000],
    "amplitudes" : [192],
    "leftFfIndex": 5,
    "rightFfIndex": 4,
    "output" :
        [
            {"index" : 0,
            "data" : 0x5},   // DUALSHOCK4_CONTROLLER_USB | DUALSHOCK4_DONGLE

            {"index" : 1,
             "dataMaskForAssertions": 0x1,
             "data" : 0x1},   // motor

            {"index" : 3,
             "data" : 0x0}
        ]
  },

  {
    "id": 1,
    "durations" : [2000, 2000, 2000, 2000, 2000],
    "amplitudes" : [16, 32, 64, 128, 255],
    "leftFfIndex": 5,
    "rightFfIndex": 4,
    "output" :
        [
          {"index" : 0,
            "data" : 0x5},   // DUALSHOCK4_CONTROLLER_USB | DUALSHOCK4_DONGLE

            {"index" : 1,
             "dataMaskForAssertions" : 0x1,
             "data" : 0x1},   // motor

            {"index" : 3,
             "data" : 0x0}
        ]
  }

]
