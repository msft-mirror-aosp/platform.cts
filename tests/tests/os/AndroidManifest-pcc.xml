<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="android.os.cts.pcc">

    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true">
        <!-- This service is required to run PCC tests, but it does nothing. -->
        <service android:name="android.os.cts.PccTestService"
            android:exported="true"
            android:privateComputeCore="true">
        </service>

        <uses-library android:name="android.test.runner"/>
    </application>

    <instrumentation android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="android.os.cts.pcc"
        android:label="CTS tests of android.os for PCC">
    </instrumentation>

    <queries>
        <package android:name="com.android.modulemetadata" />
        <package android:name="com.android.webview" />
    </queries>
</manifest>