<configuration description="Config for CTS PccSecurityTestCases">
    <option name="test-suite-tag" value="cts" />
    <option name="config-descriptor:metadata" key="component" value="security" />
    <option name="config-descriptor:metadata" key="parameter" value="not_instant_app" />
    <option name="config-descriptor:metadata" key="parameter" value="not_multi_abi" />
    <option name="config-descriptor:metadata" key="parameter" value="secondary_user" />
    <target_preparer class="com.android.tradefed.targetprep.RunCommandTargetPreparer">
        <option name="run-command" value="cmd pcc_sandbox add-allowed-package android.security.cts.pcc" />
        <option name="teardown-command" value="cmd pcc_sandbox remove-allowed-package android.security.cts.pcc" />
    </target_preparer>

    <target_preparer class="com.android.tradefed.targetprep.suite.SuiteApkInstaller">
        <option name="cleanup-apks" value="true" />
        <option name="test-file-name" value="CtsPccSecurityTestCases.apk" />
    </target_preparer>
    <object type="module_controller"
        class="com.android.tradefed.testtype.suite.module.CommandSuccessModuleController">
        <!--Skip the test if enable_pcc_framework_support is disabled - we can remove this
            once XTS tests work with AFlagsTargetPreparer -->
        <option name="run-command"
            value="aflags list | grep 'android.app.privatecompute.flags.enable_pcc_framework_support' | awk '{print $2}' | grep 'enabled'" />
    </object>
    <test class="com.android.tradefed.testtype.AndroidJUnitTest" >
        <option name="package" value="android.security.cts.pcc" />
        <option name="runner" value="androidx.test.runner.AndroidJUnitRunner" />
        <option name="class" value="android.security.cts.pcc.PccProcessSecurityTest" />
        <option name="instrument-in-pcc" value="true" />
    </test>
</configuration>
