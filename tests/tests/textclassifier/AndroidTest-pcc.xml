<configuration description="Config for CTS Sound Trigger test cases for PCC">
    <option name="test-suite-tag" value="cts" />
    <option name="config-descriptor:metadata" key="component" value="framework" />
    <option name="config-descriptor:metadata" key="parameter" value="multi_abi" />
    <option name="config-descriptor:metadata" key="parameter" value="not_instant_app" />
    <option name="config-descriptor:metadata" key="parameter" value="secondary_user" />
    <option name="config-descriptor:metadata" key="parameter" value="secondary_user_on_secondary_display" />
    <option name="config-descriptor:metadata" key="parameter" value="all_foldable_states" />

    <target_preparer class="com.android.tradefed.targetprep.suite.SuiteApkInstaller">
        <option name="cleanup-apks" value="true" />
        <option name="test-file-name" value="CtsTextClassifierPccTestCases.apk" />
    </target_preparer>

    <target_preparer class="com.android.tradefed.targetprep.RunCommandTargetPreparer">
        <option name="run-command" value="mkdir -p /data/local/tmp/cts/os" />
        <option name="run-command" value="am wait-for-broadcast-idle" />
        <option name="run-command" value="cmd pcc_sandbox add-allowed-package android.textclassifier.cts2" />
        <option name="teardown-command" value="am force-stop android.textclassifier.cts2" />
        <option name="teardown-command" value="cmd pcc_sandbox remove-allowed-package android.textclassifier.cts2" />
        <option name="teardown-command" value="rm -rf /data/local/tmp/cts/os" />
    </target_preparer>

    <test class="com.android.tradefed.testtype.AndroidJUnitTest">
        <option name="package" value="android.view.textclassifier.cts" />
        <option name="class" value="android.view.textclassifier.cts.TextClassificationTest" />
        <option name="instrument-in-pcc" value="true" />

        <option name="runner" value="androidx.test.runner.AndroidJUnitRunner" />
        <option name="runtime-hint" value="3m15s" />
        <option name="exclude-annotation" value="com.android.bedstead.enterprise.annotations.RequireRunOnWorkProfile" />
        <option name="exclude-annotation" value="com.android.bedstead.multiuser.annotations.RequireRunOnSecondaryUser" />
        <option name="exclude-filter" value="com.google.common.collect.testing"/>

    </test>
</configuration>


