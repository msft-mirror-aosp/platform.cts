<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="android.telecom.cts.thirdptycallintent"
          android:versionCode="1"
          android:versionName="1.0">

    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.HANDLE_CALL_INTENT"/>

    <!-- Gate the activity by the HANDLE_CALL_INTENT permission to ensure that callers who want to
         start the activity can only do so if they're granted the permission. This is used to verify
         that callers cannot use the permission since it's a signature level permission. -->
    <application android:label="ThirdPartyCallIntentTestApp">
        <activity android:name="android.telecom.cts.thirdptycallintent.CtsThirdPtyCallIntentActivity"
                  android:label="ThirdPtyCallIntentTestApp"
                  android:permission="android.permission.HANDLE_CALL_INTENT"
                  android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.cts.thirdptycallintent.ACTION_HANDLE_CALL_INTENT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
