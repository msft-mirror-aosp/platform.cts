package {
    default_team: "trendy_team_fwk_telephony",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "telephony-cts-ims-common-srcs",
    srcs: [
        "src/android/telephony/ims/cts/TestImsService.java",
        "src/android/telephony/ims/cts/TestRcsFeature.java",
        "src/android/telephony/ims/cts/TestMmTelFeature.java",
        "src/android/telephony/ims/cts/TestImsSmsImpl.java",
        "src/android/telephony/ims/cts/TestImsConfig.java",
        "src/android/telephony/ims/cts/TestImsRegistration.java",
        "src/android/telephony/ims/cts/TestRcsCapabilityExchangeImpl.java",
        "src/android/telephony/ims/cts/TestSipTransport.java",
        "src/android/telephony/ims/cts/TestSipDelegate.java",
        "src/android/telephony/ims/cts/TestSipDelegateConnection.java",
        "src/android/telephony/ims/cts/ImsUtils.java",
        "src/android/telephony/ims/cts/SipDialogAttributes.java",
        "src/android/telephony/ims/cts/SipMessageUtils.java",
        "src/android/telephony/ims/cts/TestAcsClient.java",
        "src/android/telephony/ims/cts/TestImsCallSessionImpl.java",
        "src/android/telephony/ims/cts/ConferenceHelper.java",
    ],
    path: "src/",
}

android_test {
    name: "CtsTelephonyTestCases",
    defaults: ["cts_defaults"],
    libs: [
        "telephony-common",
        "android.test.runner.stubs.system",
        "android.test.base.stubs.system",
        "voip-common",
    ],
    // uncomment when EuiccService tests do not use hidden APIs (Binder instances)
    //sdk_version: "test_current",
    static_libs: [
        "android.companion.flags-aconfig-java",
        "androidx.test.ext.junit",
        "ctstestrunner-axt",
        "hamcrest-library",
        "compatibility-device-util-axt",
        "truth",
        "android.telephony.mockmodem",
        "CtsTelecomUtilLib",
        "telephony_flags_core_java_lib",
        "flag-junit",
        "telecom_flags_core_java_lib",
        "telecom_module_flags-export-java",
        "telecom_module_flags-java",
        "androidx.test.rules",
        "bedstead-enterprise",
        "service-entitlement",
    ],
    srcs: [
        "src/**/*.java",
        "EmbmsMiddlewareTestApp/**/*.java",
        "EmbmsMiddlewareTestApp/**/I*.aidl",
        "LocationAccessingApp/**/*.java",
        "LocationAccessingApp/**/I*.aidl",
        "MockSatelliteGatewayServiceApp/**/*.java",
        "MockSatelliteGatewayServiceApp/**/I*.aidl",
        "MockSatelliteServiceApp/**/*.java",
        "MockSatelliteServiceApp/**/I*.aidl",
        "MockPointingUiApp/**/*.java",
        "TestExternalImsServiceApp/**/*.java",
        "TestExternalImsServiceApp/**/I*.aidl",
        "src/android/telephony/satellite/cts/I*.aidl",
        ":satellite-stub-aidl",
        "MessageUpgradeTestApp/**/*.java",
    ],
    aidl: {
        local_include_dirs: [
            "EmbmsMiddlewareTestApp/aidl/",
            "MockSatelliteGatewayServiceApp/aidl/",
            "MockSatelliteServiceApp/aidl/",
            "TestExternalImsServiceApp/aidl/",
            "src/android/telephony/satellite/cts",
        ],
    },
    test_suites: [
        "cts",
        "general-tests",
    ],
    platform_apis: true,
    host_required: [
        "compatibility-host-telephony-preconditions",
        "cts-tradefed",
    ],
    host_common_data: [
        ":compatibility-host-telephony-preconditions",
    ],
    data: [
        ":CtsTelephonyPreparerApp",
        ":CtsTelephonyCleanerApp",
        ":TestSmsApp22",
        ":LocationAccessingApp",
        ":LocationAccessingAppSdk28",
        ":MockSatelliteGatewayServiceApp",
        ":MockSatelliteServiceApp",
        ":MockPointingUiApp",
        ":TestFinancialSmsApp",
        ":TestSmsRetrieverApp",
        ":TestSmsApp",
        ":TestExternalImsServiceApp",
        ":EmbmsMiddlewareCtsTestApp",
        ":MessageUpgradeTestApp",
    ],
    per_testcase_directory: true,
}

android_test {
    name: "CtsTelephonySatelliteTestCases",
    defaults: ["cts_defaults"],
    manifest: "AndroidManifestSatellite.xml",
    libs: [
        "telephony-common",
        "android.test.runner.stubs.system",
        "android.test.base.stubs.system",
        "voip-common",
    ],
    static_libs: [
        "android.companion.flags-aconfig-java",
        "androidx.test.ext.junit",
        "ctstestrunner-axt",
        "hamcrest-library",
        "compatibility-device-util-axt",
        "truth",
        "android.telephony.mockmodem",
        "CtsTelecomUtilLib",
        "telephony_flags_core_java_lib",
        "flag-junit",
        "telecom_flags_core_java_lib",
        "telecom_module_flags-export-java",
        "telecom_module_flags-java",
        "androidx.test.rules",
        "bedstead-enterprise",
        "service-entitlement",
        "telephony-cts-utils",
    ],
    srcs: [
        "src/android/telephony/satellite/cts/CarrierRoamingSatelliteTestBase.java",
        "src/android/telephony/satellite/cts/EntilementStatusResponseGenerator.java",
        "src/android/telephony/satellite/cts/MockPointingUiActivity.java",
        "src/android/telephony/satellite/cts/MockSatelliteGatewayService.java",
        "src/android/telephony/satellite/cts/MockSatelliteService.java",
        "src/android/telephony/satellite/cts/MockSatelliteServiceManager.java",
        "src/android/telephony/satellite/cts/SatelliteImsCallingBase.java",
        "src/android/telephony/satellite/cts/SatelliteManagerForNbIotNtnTest.java",
        "src/android/telephony/satellite/cts/SatelliteManagerOnMockServiceTestBase.java",
        "src/android/telephony/satellite/cts/SatelliteManagerTestBase.java",
        "src/android/telephony/satellite/cts/SatelliteManagerTestOnMockService.java",
        "src/android/telephony/satellite/cts/SatelliteReceiver.java",
        "src/android/telephony/cts/ServiceStateRadioStateListener.java",
        "src/android/telephony/cts/InCallServiceStateValidator.java",
        "src/android/telephony/ims/cts/ImsServiceConnector.java",
        ":telephony-cts-ims-common-srcs",
        "MockSatelliteGatewayServiceApp/**/*.java",
        "MockSatelliteGatewayServiceApp/**/I*.aidl",
        "MockSatelliteServiceApp/**/*.java",
        "MockSatelliteServiceApp/**/I*.aidl",
        "MockPointingUiApp/**/*.java",
        "src/android/telephony/satellite/cts/I*.aidl",
        "TestExternalImsServiceApp/**/*.java",
        "TestExternalImsServiceApp/**/I*.aidl",
    ],
    aidl: {
        include_dirs: ["frameworks/base/telephony/java"],
        local_include_dirs: [
            "MockSatelliteGatewayServiceApp/aidl/",
            "MockSatelliteServiceApp/aidl/",
            "TestExternalImsServiceApp/aidl/",
            "src/android/telephony/satellite/cts",
        ],
    },
    test_suites: [
        "cts",
        "general-tests",
    ],
    test_config: "AndroidTestSatellite.xml",
    platform_apis: true,
    host_required: [
        "compatibility-host-telephony-preconditions",
        "cts-tradefed",
    ],
    host_common_data: [
        ":compatibility-host-telephony-preconditions",
    ],
    data: [
        ":CtsTelephonyPreparerApp",
        ":CtsTelephonyCleanerApp",
        ":MockSatelliteGatewayServiceApp",
        ":MockSatelliteServiceApp",
        ":MockPointingUiApp",
        ":TestExternalImsServiceApp",
    ],
    per_testcase_directory: true,
}
