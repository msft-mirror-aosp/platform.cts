package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_android_data_aegis",
}

android_test {
    name: "CtsContactsProviderTestsRestrictDataFieldsSdk37",
    defaults: ["cts_defaults"],

    test_suites: [
        "cts",
        "general-tests",
        "sts",
    ],
    libs: [
        "android.test.base.stubs.test",
    ],

    srcs: [
        "src/**/*.java",
        ":TestDataBuilder",
    ],

    static_libs: [
        "androidx.test.ext.junit",
        "ctstestrunner-axt",
        "contactsprovider_flags_java_lib",
        "flag-junit",
    ],

    min_sdk_version: "30",
    sdk_version: "current",
}
