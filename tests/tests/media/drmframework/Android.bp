package {
    // See: http://go/android-license-faq
    default_applicable_licenses: [
        "Android-Apache-2.0",
        "cts_tests_tests_media_license",
    ],
    default_team: "trendy_team_android_media_drm",
}

java_defaults {
    name: "MediaDrmFrameworkTestCases_defaults",
    defaults: ["cts_defaults"],
    // include both the 32 and 64 bit versions
    compile_multilib: "both",
    static_libs: [
        "ctsmediav2common",
        "ctstestrunner-axt",
        "hamcrest-library",
        "testng",
    ],
    aaptflags: [
        "--auto-add-overlay",
        // Give com.android.media.drmframework.cts Java files access to the R class
        "--extra-packages com.android.media.drmframework.cts",

        // Do not compress these files:
        "-0 .heic",
        "-0 .mxmf",
        "-0 .ota",
        "-0 .trp",
        "-0 .ts",
        "-0 .vp9",
    ],
    jni_libs: [
        "libmediadrm_jni",
        "libnativehelper_compat_libc++",
    ],
    srcs: [
        "aidl/**/*.aidl",
        "src/**/*.java",
    ],
    libs: [
        "android.test.base.stubs.system",
        "android.test.runner.stubs.system",
    ],
    host_required: ["cts-dynamic-config"],
    host_common_data: [":cts-dynamic-config"],
    sdk_version: "test_current",
    min_sdk_version: "29",
    target_sdk_version: "31",
}

android_test {
    name: "CtsMediaDrmFrameworkTestCases",
    defaults: ["MediaDrmFrameworkTestCases_defaults"],
    test_config: "AndroidTest.xml",
    test_suites: [
        "cts",
        "general-tests",
    ],
}

android_test {
    name: "MctsMediaDrmFrameworkTestCases",
    defaults: ["MediaDrmFrameworkTestCases_defaults"],
    test_config: "AndroidTest-mcts.xml",
    test_suites: [
        "cts",
        "general-tests",
        "mcts-media",
        "mts-media",
    ],
}

test_module_config {
    name: "CtsMediaDrmFrameworkTestCases_Presubmit",
    base: "CtsMediaDrmFrameworkTestCases",
    test_suites: ["general-tests"],
    include_annotations: ["android.platform.test.annotations.Presubmit"],
}
