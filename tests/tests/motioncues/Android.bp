android_library {
    name: "CtsMotionCuesTestCases_lib",
    srcs: [
        "src/**/*.java",
    ],
    libs: [
        "platform-test-annotations",
        "android.test.runner.stubs.system",
        "android.test.base.stubs.system",
    ],
    static_libs: [
        "androidx.test.core",
        "androidx.test.rules",
        "androidx.test.ext.truth",
        "compatibility-device-util-axt",
        "ctstestrunner-axt",
        "platform-test-rules",
        "SystemUI-proto",
        "testng",
        "bedstead-root",
    ],
    resource_dirs: [
        "res",
    ],
    platform_apis: true,
}

android_test {
    name: "CtsMotionCuesTestCases",
    defaults: ["cts_defaults"],
    team: "trendy_team_motioncues",
    // Tag this module as a cts test artifact
    test_suites: [
        "cts",
        "general-tests",
    ],
    static_libs: [
        "CtsMotionCuesTestCases_lib",
    ],
    platform_apis: true,
    resource_dirs: [],
    sdk_version: "test_current",
}

team {
