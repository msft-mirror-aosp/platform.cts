package {
    default_team: "trendy_team_fwk_telephony",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "cts-telecom2-test-manifest",
    srcs: ["AndroidManifest.xml"],
    visibility: ["//packages/modules/Telephony:__subpackages__"],
}

android_library {
    name: "CtsTelecomTestCases2Lib",
    defaults: ["cts_defaults"],
    static_libs: [
        "compatibility-device-util-axt",
        "ctstestrunner-axt",
        "telephony_flags_core_java_lib",
        "CtsTelecomUtilLib",
    ],
    libs: ["android.test.base.stubs.test"],
    srcs: [
        "src/**/*.java",
    ],
    lint: {
        baseline_filename: "lint-baseline.xml",
    },
    sdk_version: "test_current",
    min_sdk_version: "23",
    visibility: [
        "//packages/modules/Telephony:__subpackages__",
    ],
}
