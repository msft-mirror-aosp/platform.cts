<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.cts.allowcomponentaccess.source_notag">

    <application>
        <receiver android:name="com.android.cts.allowcomponentaccess.source.ActionRelayReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.cts.allowcomponentaccess.ACTION_RELAY" />
            </intent-filter>
        </receiver>
    </application>

    <queries>
        <package android:name="com.android.cts.allowcomponentaccess.target_notag" />
        <package android:name="com.android.cts.allowcomponentaccess.target_allow" />
        <package android:name="com.android.cts.allowcomponentaccess.target_block" />
        <package android:name="android.content.cts" />
        <package android:name="com.android.cts.dummy" />
    </queries>

</manifest>