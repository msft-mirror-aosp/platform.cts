package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app_certificate {
    name: "cts-allow-access-cert",
    certificate: "certs/cts-allow-access-cert",
}

android_test_helper_app {
    name: "CtsAllowComponentAccessSourceAllow",
    manifest: "Source_Allow_AndroidManifest.xml",
    srcs: [
        "src/**/*.java",
        ":CtsAllowComponentAccessTest_Constants",
        ":CtsAllowComponentAccessTest_Aidl",
    ],
    certificate: ":cts-allow-access-cert",
    sdk_version: "current",
}

