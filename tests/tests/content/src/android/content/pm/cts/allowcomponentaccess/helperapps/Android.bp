package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test_helper_app {
    name: "CtsAllowComponentAccessSourceAllow",
    manifest: "Source_Allow_AndroidManifest.xml",
    srcs: [
        "src/**/*.java",
        ":CtsAllowComponentAccessTest_Constants",
        ":CtsAllowComponentAccessTest_Aidl",
    ],
    sdk_version: "current",
}

