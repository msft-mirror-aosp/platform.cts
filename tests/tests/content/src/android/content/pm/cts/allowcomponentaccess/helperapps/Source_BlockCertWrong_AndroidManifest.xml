<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.cts.allowcomponentaccess.source_block_cert_wrong">
    <allow-component-access>
        <!-- Correct package name, but WRONG certificate digest -->
        <package android:name="com.android.cts.allowcomponentaccess.target_allow"
            android:certDigest="FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF" />
        <package android:name="android.content.cts" />
    </allow-component-access>
    <application>
        <receiver android:name="com.android.cts.allowcomponentaccess.source.ActionRelayReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.cts.allowcomponentaccess.ACTION_RELAY" />
            </intent-filter>
        </receiver>
    </application>
    <queries>
        <package android:name="com.android.cts.allowcomponentaccess.target_allow" />
        <package android:name="android.content.cts" />
    </queries>
</manifest>
