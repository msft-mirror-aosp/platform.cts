package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_framework_bpm",
}

android_test {
    name: "CtsSyncManagerTestCases",
    defaults: [
        "cts_defaults",
    ],
    static_libs: [
        "androidx.test.rules",
        "androidx.test.ext.junit",
        "cts_content_shared_lib",
        "junit",
        "mockito-target",
        "services.core",
    ],
    srcs: [
        "src/**/*.java",
    ],
    test_suites: [
        "cts",
        "general-tests",
    ],
    data: [
        ":CtsSyncAccountAccessStubs",
    ],
    platform_apis: true,
    min_sdk_version: "28",
    target_sdk_version: "36",
    manifest: "AndroidManifest.xml",
    test_config: "AndroidTest.xml",
    per_testcase_directory: true,

}
