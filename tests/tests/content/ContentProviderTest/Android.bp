package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_framework_backstage_power",
}

android_test {
    name: "CtsContentProviderTestCases",
    defaults: [
        "cts_defaults",
    ],
    libs: [
        "android.test.mock.stubs.system",
    ],
    jni_libs: [
        "libnativecursorwindow_jni",
    ],
    static_libs: [
        "androidx.test.rules",
        "androidx.test.ext.junit",
        "bedstead-enterprise",
        "cts_content_shared_lib",
        "junit",
        "mockito-target",
        "truth",
    ],
    resource_dirs: ["res"],
    srcs: [
        "src/**/*.java",
    ],
    test_suites: [
        "cts",
        "general-tests",
    ],
    platform_apis: true,
    min_sdk_version: "29",
    target_sdk_version: "36",
    manifest: "AndroidManifest.xml",
    test_config: "AndroidTest.xml",
    per_testcase_directory: true,
}

test_module_config {
    name: "CtsContentProviderTestCases_postsubmit",
    base: "CtsContentProviderTestCases",
    test_suites: ["general-tests"],
    exclude_annotations: ["androidx.test.filters.FlakyTest"],
}
