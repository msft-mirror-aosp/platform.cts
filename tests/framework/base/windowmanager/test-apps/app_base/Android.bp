package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "cts-wm-components-base",
    srcs: [
        "**/ComponentsBase.java",
        "**/ComponentsProvider.kt",
        "**/ComponentsProviderExtension.kt",
    ],
    visibility: ["//visibility:private"],
}

java_library {
    name: "cts-wm-components-lib",

    srcs: [
        ":cts-wm-components",
        ":cts-wm-components-base",
        ":cts-wm-components-util",
    ],

    static_libs: [
        "androidx.annotation_annotation",
        "androidx.test.rules",
        "compatibility-device-util-axt",
    ],

    sdk_version: "test_current",
    visibility: ["//cts/tests/framework/base/windowmanager/util"],
}

java_test_helper_library {
    name: "cts-wm-app-base",

    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
    exclude_srcs: [":cts-wm-components-base"],

    static_libs: ["cts-wm-components-lib"],

    sdk_version: "test_current",
    visibility: [
        "//cts/tests/framework/base/biometrics/apps:__subpackages__",
        "//cts/tests/framework/base/windowmanager/backgroundactivity:__subpackages__",
        "//cts/tests/framework/base/windowmanager/jetpack:__subpackages__",
        "//cts/tests/framework/base/windowmanager/test-apps:__subpackages__",
        "//cts/tests/surfacecontrol/scvhapp",
    ],
}
