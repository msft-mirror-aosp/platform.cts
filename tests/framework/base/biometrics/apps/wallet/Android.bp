package {
    default_team: "trendy_team_biometrics_framework",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "cts_biometric_wallet_test_app_defaults",
    defaults: ["cts_support_defaults"],
    static_libs: [
        "cts-biometric-util",
        "cts-wm-app-base",
    ],
    srcs: ["src/**/*.java"],
    sdk_version: "test_current",
    test_suites: [
        "cts",
        "general-tests",
    ],
}

android_test_helper_app {
    name: "CtsBiometricServiceWalletTestApp",
    defaults: ["cts_biometric_wallet_test_app_defaults"],
    manifest: "AndroidManifest.xml",
}

android_test_helper_app {
    name: "CtsBiometricServiceNoApiPermissionWalletTestApp",
    defaults: ["cts_biometric_wallet_test_app_defaults"],
    manifest: "AndroidManifest_NoApiPermission.xml",
}

android_test_helper_app {
    name: "CtsBiometricServiceNoBioPermissionWalletTestApp",
    defaults: ["cts_biometric_wallet_test_app_defaults"],
    manifest: "AndroidManifest_NoBioPermission.xml",
}
