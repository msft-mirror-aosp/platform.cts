package android.mediapc.cts.common;

/**
 * Precondition constants generated from MPC requirements.
 */
public final class PreconditionConstants {
{{- range $r := .ReqList.GetRequirements }}
    {{- range $m_id, $m := $r.GetMeasurements }}
        {{- $mt := $m.GetMeasurementType}}
        {{- range $mpc, $s := $r.GetSpecs }}
            {{- with index $s.GetRequiredValues $m_id }}
    /** {{ $r.GetId }} {{ $m_id }} MPC {{ $mpc }} */
    public static final {{template "JavaType" $mt}} {{SafeReqID $r.GetId | UpperCase}}_{{UpperCase $m_id}}_MPC_{{$mpc}} = {{template "MeasurementValue" Dict "RequiredValue" . "MeasurementType" $mt}};
            {{- end }}
        {{- end }}
    {{- end }}
{{- end }}

    private PreconditionConstants() {}
}
