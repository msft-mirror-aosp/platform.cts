# proto-file: third_party/android/mediapc_requirements/requirements.proto
# proto-message: Requirement
id: "7.5/H-1-9"
name: "Camera Slow Motion"
description: "Slow-mo recording"
test_configs: {
  key: ""
  value: {
    description: "Default test config"
    proto_field_number: 57
  }
}
measurements: {
  key: "rear_camera_240fps_supported"
  value: {
    description: "Is the rear primary camera slow motion supported"
    measurement_type: MEASUREMENT_TYPE_BOOL
    comparison: COMPARISON_EQUAL
    proto_field_number: 3
  }
}
specs {
  key: 33
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_13
    specification: "MUST have a rear-facing primary camera supporting 720p or 1080p @ 240fps."
    required_values {
      key: "rear_camera_240fps_supported"
      value {
        bool_value: true
      }
    }
  }
}
specs {
  key: 34
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_14
    specification: "same"
    required_values {
      key: "rear_camera_240fps_supported"
      value {
        bool_value: true
      }
    }
  }
}
specs {
  key: 35
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_15
    specification: "same"
    required_values {
      key: "rear_camera_240fps_supported"
      value {
        bool_value: true
      }
    }
  }
}
specs {
  key: 37
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_17
    specification: "same"
    required_values {
      key: "rear_camera_240fps_supported"
      value {
        bool_value: true
      }
    }
  }
}
