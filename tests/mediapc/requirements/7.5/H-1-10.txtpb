      value {
        bool_value: true
      }
    }
    required_values {
      key: "front_camera_ultrawide_zoom_req_met"
      value {
        bool_value: true
      }
    }
  }
}
specs {
  key: 37
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_17
    specification: "same"
    required_values {
      key: "rear_camera_ultrawide_zoom_req_met"
