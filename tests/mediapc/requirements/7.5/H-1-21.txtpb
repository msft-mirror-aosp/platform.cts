# proto-file: cts/tests/mediapc/requirements/requirements.proto
# proto-message: Requirement
id: "7.5/H-1-21"
name: "At least one camera"
description: "At least one camera"
specs {
  key: 10
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_10
    specification: "MUST have at least one front facing camera or rear facing camera."
    required_values {
      key: "front_and_rear_camera_count"
      value {
        int_value: 1
      }
    }
  }
}
specs {
  key: 20
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_20
    specification: "MUST have at least one front facing camera or rear facing camera."
    required_values {
      key: "front_and_rear_camera_count"
      value {
        int_value: 1
      }
    }
  }
}
measurements {
  key: "front_and_rear_camera_count"
  value {
    description: "Count of both front and rear cameras."
    measurement_type: MEASUREMENT_TYPE_INT
    comparison: COMPARISON_GREATER_THAN_OR_EQUAL
    proto_field_number: 5
  }
}
measurements {
  key: "front_camera_count"
  value {
    description: "Count of front cameras."
    measurement_type: MEASUREMENT_TYPE_INT
    comparison: COMPARISON_INFO_ONLY
    proto_field_number: 3
  }
}
measurements {
  key: "rear_camera_count"
  value {
    description: "Count of rear cameras."
    measurement_type: MEASUREMENT_TYPE_INT
    comparison: COMPARISON_INFO_ONLY
    proto_field_number: 4
  }
}
test_configs {
  key: ""
  value {
    description: "Default test config"
    proto_field_number: 87
  }
}
