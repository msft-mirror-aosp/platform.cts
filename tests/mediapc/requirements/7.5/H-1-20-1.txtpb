# proto-file: cts/tests/mediapc/requirements/requirements.proto
# proto-message: Requirement

# Split from 7.5/H-1-20 for independent grading.
id: "7.5/H-1-20-1"
group: GROUP_CAMERA
name: "Front Camera Ultra HDR"
description: "Ultra HDR support for front primary camera"
comment: "Split from 7.5/H-1-20 for independent grading."
specs {
  key: 35
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_35
    specification: "MUST by default output JPEG_R for the primary front camera in the native camera app."
    required_values {
      key: "ultra_hdr_supported"
      value {
        bool_value: true
      }
    }
  }
}
specs {
  key: 37
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_37
    specification: "MUST by default output JPEG_R for the primary front camera in the native camera app."
    required_values {
      key: "ultra_hdr_supported"
      value {
        bool_value: true
      }
    }
  }
}
measurements {
  key: "ultra_hdr_supported"
  value {
    description: "Is the front primary camera Ultra HDR supported"
    measurement_type: MEASUREMENT_TYPE_BOOL
    comparison: COMPARISON_EQUAL
    proto_field_number: 3
  }
}
is_non_cts_test: true
test_configs {
  key: ""
  value {
    description: "Default test config"
    proto_field_number: 104
  }
}
