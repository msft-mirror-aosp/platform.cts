# proto-file: cts/tests/mediapc/requirements/requirements.proto
# proto-message: Requirement
id: "7.5/H-1-15"
name: "Camera Night Mode Extension"
description: "Night mode extension"
specs {
  key: 34
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_34
    specification:
      "MUST support Night mode extensions via both CameraX and Camera2 "
      "extensions for primary cameras."
    required_values {
      key: "front_camera2_extension_night_supported"
      value {
        bool_value: true
      }
    }
    required_values {
      key: "front_camerax_extension_night_supported"
      value {
        bool_value: true
      }
    }
    required_values {
      key: "rear_camera2_extension_night_supported"
      value {
        bool_value: true
      }
    }
    required_values {
      key: "rear_camerax_extension_night_supported"
      value {
        bool_value: true
      }
    }
  }
}
