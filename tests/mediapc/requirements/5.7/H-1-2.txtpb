# proto-file: cts/tests/mediapc/requirements/requirements.proto
# proto-message: Requirement
id: "5.7/H-1-2"
name: "Media Drm Security Level Hardware Secure All"
description: "Hardware-backed trusted execution environment"
specs {
  key: 33
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_13
    specification: "MUST support `MediaDrm.SECURITY_LEVEL_HW_SECURE_ALL` with the below content decryption capabilities. <table> <tbody> <tr> <td><strong>Minimum Sample size</strong></td> <td><strong>4 MiB</strong></td> </tr> <tr> <td><strong>Minimum Number of Subsamples - H264 or HEVC</strong></td> <td><strong>32 </strong></td> </tr> <tr> <td><strong>Minimum Number of Subsamples - VP9 </strong></td> <td><strong>9 </strong></td> </tr> <tr> <td><strong>Minimum Number of Subsamples - AV1</strong></td> <td><strong>288 </strong></td> </tr> <tr> <td><strong>Minimum subsample buffer size </strong></td> <td><strong>1 MiB </strong></td> </tr> <tr> <td><strong>Minimum Generic crypto buffer size </strong></td> <td><strong>500 KiB</strong></td> </tr> <tr> <td><strong>Minimum Number of concurrent sessions</strong></td> <td><strong>30</strong></td> </tr> <tr> <td><strong>Minimum Number of keys per session </strong></td> <td><strong>20</strong></td> </tr> <tr> <td><strong>Minimum Total Number of Keys (all sessions)</strong></td> <td><strong>80 </strong></td> </tr> <tr> <td><strong> Minimum Total Number of DRM Keys (all sessions)</strong></td> <td><strong>6</strong></td> </tr> <tr> <td><strong>Message Size  </strong></td> <td><strong>16 KiB</strong></td> </tr> <tr> <td><strong>Decrypted Frames per Second</strong></td> <td><strong>60 fps</strong></td> </tr> </tbody> </table>"
    required_values {
      key: "number_crypto_hw_secure_all_support"
      value {
        int_value: 1
      }
    }
  }
}
specs {
  key: 34
  value {
