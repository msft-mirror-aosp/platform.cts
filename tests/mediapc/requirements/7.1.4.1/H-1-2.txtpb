    id: "egl_img_context_priority"
    description: "Is EGL_IMG_context_priority supported."
    measurement_type: MEASUREMENT_TYPE_BOOL
    comparison: COMPARISON_EQUAL
    proto_field_number: 3
  }
}
measurements: {
  key: "egl_ext_protected_content"
  value: {
    id: "egl_ext_protected_content"
    description: "Is EGL_EXT_protected_content supported."
    measurement_type: MEASUREMENT_TYPE_BOOL
    comparison: COMPARISON_EQUAL
