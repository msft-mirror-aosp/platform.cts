# proto-file: cts/tests/mediapc/requirements/requirements.proto
# proto-message: Requirement
id: "5.2/H-2-2"
group: GROUP_MEDIA
name: "MMAP Speaker Path"
description: "Support MMAP on the speaker path."
specs {
  key: 37
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_37
    specification: "MUST support MMAP on the speaker path."
    required_values {
      key: "has_speaker"
      value {
        bool_value: true
      }
    }
    required_values {
      key: "mmap_on_speaker_path_supported"
      value {
        bool_value: true
      }
    }
  }
}
measurements {
  key: "has_speaker"
  value {
    description: "Does the device have a speaker"
    measurement_type: MEASUREMENT_TYPE_BOOL
    comparison: COMPARISON_EQUAL
    proto_field_number: 4
  }
}
measurements {
  key: "mmap_on_speaker_path_supported"
  value {
    description: "Does the device support MMAP on the speaker path"
    measurement_type: MEASUREMENT_TYPE_BOOL
    comparison: COMPARISON_EQUAL
    proto_field_number: 3
  }
}
test_configs {
  key: ""
  value {
    description: "Default test config"
    proto_field_number: 106
  }
}
