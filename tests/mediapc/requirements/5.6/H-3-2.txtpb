# proto-file: cts/tests/mediapc/requirements/requirements.proto
# proto-message: Requirement
id: "5.6/H-3-2"
group: GROUP_MEDIA
name: "USB Audio Output Channels"
description: "Support at least 8 output channels for USB audio devices."
comment:
  "The test may not test up to the maximum number supported but it will "
  "always test at least the required value."
specs {
  key: 37
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_37
    specification: "MUST support at least 8 output channels for USB audio devices. Channel masks up to 8 channels must be supported. This includes mono, stereo, quad, 5.1, and 7.1."
    required_values {
      key: "tested_output_channel_count"
      value {
        int_value: 8
      }
    }
    required_values {
      key: "max_output_channel_count"
      value {
        int_value: 8
      }
    }
  }
}
measurements {
  key: "tested_output_channel_count"
  value {
    description: "The number of output channels tested for USB audio devices."
    measurement_type: MEASUREMENT_TYPE_INT
    comparison: COMPARISON_GREATER_THAN_OR_EQUAL
    proto_field_number: 3
  }
}
measurements {
  key: "max_output_channel_count"
  value {
    description: "Maximum number of output channels supported for USB audio devices."
    measurement_type: MEASUREMENT_TYPE_INT
    comparison: COMPARISON_GREATER_THAN_OR_EQUAL
    proto_field_number: 4
  }
}
test_configs {
  key: ""
  value {
    description: "Default test config"
    proto_field_number: 108
  }
}
