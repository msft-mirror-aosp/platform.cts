# proto-file: cts/tests/mediapc/requirements/requirements.proto
# proto-message: Requirement
id: "5.6/H-3-3"
group: GROUP_MEDIA
name: "USB Audio Input Channels"
comment:
  "The test may not test up to the maximum number supported but it will "
  "always test at least the required value."
description: "Support at least 4 input channels for USB audio devices."
specs {
  key: 37
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_37
    specification: "MUST support at least 4 input channels for USB audio devices."
    required_values {
      key: "tested_input_channel_count"
      value {
        int_value: 4
      }
    }
    required_values {
      key: "max_input_channel_count"
      value {
        int_value: 4
      }
    }
  }
}
measurements {
  key: "tested_input_channel_count"
  value {
    description: "The number input channels tested for USB audio devices."
    measurement_type: MEASUREMENT_TYPE_INT
    comparison: COMPARISON_GREATER_THAN_OR_EQUAL
    proto_field_number: 3
  }
}
measurements {
  key: "max_input_channel_count"
  value {
    description: "Maximum number of input channels supported for USB audio devices."
    measurement_type: MEASUREMENT_TYPE_INT
    comparison: COMPARISON_GREATER_THAN_OR_EQUAL
    proto_field_number: 4
  }
}
test_configs {
  key: ""
  value {
    description: "Default test config"
    proto_field_number: 109
  }
}
