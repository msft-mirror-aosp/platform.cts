# proto-file: third_party/android/mediapc_requirements/requirements.proto
# proto-message: Requirement
id: "5.6/H-1-2"
name: "Round Trip Audio Latency"
description: "Round-trip audio latency"
is_non_cts_test: true
test_configs: {
  key: ""
  value: {
    description: "Default test config"
    proto_field_number: 47
  }
}
measurements: {
  key: "round_trip_audio_latency_ms"
  value: {
    description: "Round-trip audio latency in milliseconds"
    measurement_type: MEASUREMENT_TYPE_DOUBLE
    comparison: COMPARISON_LESS_THAN_OR_EQUAL
    proto_field_number: 3
  }
}
specs {
  key: 33
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_13
    specification: "MUST have a round-trip audio latency of 80 milliseconds or less over at least one supported data path."
    required_values {
      key: "round_trip_audio_latency_ms"
      value {
        double_value: 80.0
      }
    }
  }
}
specs {
  key: 34
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_14
    specification: "same"
    required_values {
      key: "round_trip_audio_latency_ms"
      value {
        double_value: 80.0
      }
    }
  }
}
specs {
  key: 35
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_15
    specification: "same"
    required_values {
      key: "round_trip_audio_latency_ms"
      value {
        double_value: 80.0
      }
    }
  }
}
specs {
  key: 37
  value {
    mpc: MEDIA_PERFORMANCE_CLASS_17
    specification: "same"
    required_values {
      key: "round_trip_audio_latency_ms"
      value {
        double_value: 80.0
      }
    }
  }
}
