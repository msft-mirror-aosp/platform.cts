<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="android.view.inputmethod.cts.installtests">

    <uses-sdk android:targetSdkVersion="32"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>

    <!-- We need INTERACT_ACROSS_USERS to survive killBackgroundUserProcessesWithAudioRecordPermission. See bug 498084557. -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" tools:remove="android:maxSdkVersion" />

    <queries>
        <intent>
            <action android:name="android.view.InputMethod"/>
        </intent>
    </queries>

    <application android:label="CtsInputMethodInstallTestCases"
        android:requestLegacyExternalStorage="true" />

    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="android.view.inputmethod.cts.installtests"/>

</manifest>
