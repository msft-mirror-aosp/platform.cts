package {
    default_team: "trendy_team_input_method_framework",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_test_helper_library {
    name: "CtsMockInputMethodLib",
    sdk_version: "test_current",

    // TODO: ideally we should split MockIme source files into three categories
    //       1) common, 2) common + IME-only, and 3) common + client-only.
    //       Currently, both MockIme APK and test APKs that use MockIme contain
    //       all the Java classes, which is inefficient.
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
    libs: ["junit"],
    static_libs: [
        "android.view.inputmethod.flags-aconfig-java",
        "androidx.annotation_annotation",
        "androidx.autofill_autofill",
        "compatibility-device-util-axt",
        "cts_window_extensions_jetpack_util",
        "cts_window-extensions",
        "cts_window-extensions-core",
    ],
}

java_defaults {
    name: "CtsMockInputMethodBase",

    defaults: ["cts_defaults"],
    optimize: {
        enabled: false,
    },
    sdk_version: "current",
    min_sdk_version: "21",
    static_libs: [
        "CtsMockInputMethodLib",
    ],
}

android_test_helper_app {
    name: "CtsMockInputMethod",
    defaults: ["CtsMockInputMethodBase"],
    manifest: "AndroidManifest_mockime1.xml",
    additional_manifests: [
        "AndroidManifest_template.xml",
    ],
}

android_test_helper_app {
    name: "CtsMockInputMethod2",
    defaults: ["CtsMockInputMethodBase"],
    manifest: "AndroidManifest_mockime2.xml",
    additional_manifests: [
        "AndroidManifest_template.xml",
    ],
}

android_test_helper_app {
    name: "CtsMockInputMethodWithManySubtypes",
    defaults: ["CtsMockInputMethodBase"],
    manifest: "AndroidManifest_mockime_with_many_subtypes.xml",
    additional_manifests: [
        "AndroidManifest_template_many_subtypes.xml",
        "AndroidManifest_template.xml",
    ],
}
