<configuration description="Config for CTS Conscrypt test cases">
    <option name="test-suite-tag" value="cts" />
    <option name="config-descriptor:metadata" key="component" value="conscrypt" />
    <option name="config-descriptor:metadata" key="parameter" value="multi_abi" />
    <option name="config-descriptor:metadata" key="parameter" value="not_instant_app" />
    <option name="config-descriptor:metadata" key="parameter" value="secondary_user" />

    <target_preparer class="com.android.tradefed.targetprep.suite.SuiteApkInstaller">
        <option name="cleanup-apks" value="true" />
        <!-- Make sure this matches the 'name' of your module in Android.bp -->
        <option name="test-file-name" value="CtsConscryptTestCases.apk" />
    </target_preparer>

    <!-- Use the standard Android JUnit runner instead of the custom LibcoreTest -->
    <test class="com.android.tradefed.testtype.AndroidJUnitTest" >
        <option name="package" value="android.conscrypt.cts" />
        <option name="runtime-hint" value="15m"/>
        <option name="hidden-api-checks" value="false"/>
    </test>
</configuration>