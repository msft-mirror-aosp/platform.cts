android_test {
    name: "CtsContentRestrictionTestCases",
    defaults: ["cts_defaults"],
    team: "trendy_team_android_content_restriction",
    static_libs: [
        "androidx.test.ext.junit",
        "compatibility-device-util-axt",
        "ctstestrunner-axt",
        "truth",
        "android.app.contentrestriction.flags-aconfig-java",
        "bedstead-flags",
        "bedstead-root",
        "TestApp",
        "Nene",
    ],
    srcs: ["src/**/*.kt"],
    test_suites: [
        "cts",
        "general-tests",
    ],
    sdk_version: "test_current",
}

team {
    name: "trendy_team_android_content_restriction",

    // go/trendy/manage/engineers/5092769766146048
    trendy_team_id: "5092769766146048",
}
