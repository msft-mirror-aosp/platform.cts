package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_android_storage",
}

android_test {
    name: "CtsDownloadManagerTestCases",
    defaults: ["cts_defaults"],
    libs: [
        "android.test.runner.stubs.test",
        "android.test.base.stubs.test",
    ],
    static_libs: [
        "androidx.test.rules",
        "bedstead",
        "compatibility-device-util-axt",
        "ctstestrunner-axt",
        "ctstestserver",
        "download_manager_lib",
    ],
    exclude_srcs: [
        "src/android/app/cts/downloadmanager/DownloadManagerTestBase.java",
    ],
    srcs: [
        "src/**/*.java",
    ],
    // Tag this module as a cts test artifact
    test_suites: [
        "cts",
        "general-tests",
    ],
    instrumentation_for: "CtsAppTestStubs",
    sdk_version: "test_current",
    min_sdk_version: "29",
    manifest: "AndroidManifest.xml",
    test_config: "AndroidTest.xml",
    dxflags: ["--multi-dex"],
    data: [
        ":CtsAppTestStubs",
        ":StorageDelegator",
    ],
    per_testcase_directory: true,
}

android_library {
    name: "download_manager_lib",
    srcs: [
        "src/android/app/cts/downloadmanager/DownloadManagerTestBase.java",
    ],
    static_libs: [
        "androidx.test.rules",
        "compatibility-device-util-axt",
        "ctstestserver",
    ],
    min_sdk_version: "29",
    platform_apis: true,
}

test_module_config {
    name: "CtsDownloadManagerTestCases_cts_downloadmanagertest",
    base: "CtsDownloadManagerTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.app.cts.downloadmanager.DownloadManagerTest"],
}
