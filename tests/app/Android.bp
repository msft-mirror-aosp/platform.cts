package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_framework_backstage_power",
}

android_test {
    name: "CtsAppTestCases",
    defaults: ["cts_defaults"],
    libs: [
        "android.test.runner.stubs.test",
        "org.apache.http.legacy.stubs.test",
        "android.test.base.stubs.test",
    ],
    static_libs: [
        "compatibility-device-util-axt",
        "ctstestrunner-axt",
        "ctstestserver",
        "cts-wm-util",
        "mockito-target-minus-junit4",
        "androidx.test.ext.junit",
        "androidx.test.rules",
        "platform-test-annotations",
        "platformprotosnano",
        "permission-test-util-lib",
        "cts_app_test_shared_lib",
        "android.content.pm.flags-aconfig-java",
        "android.multiuser.flags-aconfig-java",
        "am_flags_lib",
        "flag-junit",
        "com.android.media.flags.bettertogether-aconfig-java",
        "android.app.flags-aconfig-java",
        "ravenwood-junit",
        "bedstead",
    ],
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
    // Tag this module as a cts test artifact
    test_suites: [
        "cts",
        "general-tests",
        "sts",
    ],
    instrumentation_for: "CtsAppTestStubs",
    sdk_version: "test_current",
    // 29 required for Harrier.
    min_sdk_version: "29",
    // Disable coverage since it pushes us over the dex limit and we don't
    // actually need to measure the tests themselves.
    jacoco: {
        exclude_filter: ["**"],
    },
    // Even with coverage disabled, we're close to the single dex limit, so allow use of multi-dex.
    dxflags: ["--multi-dex"],
    data: [
        ":CtsSimpleApp",
        ":CtsAppTestDelayedStart",
        ":CtsAppTestStubs",
        ":CtsAppTestStubsApp1",
        ":CtsAppTestStubsApp3",
        ":CtsAppTestStubsApp2",
        ":CtsAppTestStubsApi30",
        ":CtsAppTestStubsApi34",
        ":CtsAppTestWedgedStart",
        ":CtsBadProviderStubs",
        ":CtsCantSaveState1",
        ":CtsCantSaveState2",
        ":StorageDelegator",
        ":CtsActivityManagerApi29",
        ":WallpaperTest",
        ":CtsAppTestProviderApp",
    ],
    per_testcase_directory: true,
}

android_ravenwood_test {
    name: "CtsAppTestCasesRavenwood",
    static_libs: [
        "androidx.annotation_annotation",
        "androidx.test.rules",
        "compatibility-device-util-axt-ravenwood",
    ],
    srcs: [
        "src/android/app/cts/ActivityOptionsTest.java",
        "src/android/app/cts/InstrumentationThreadingTest.java",
    ],
    auto_gen_config: true,
    team: "trendy_team_ravenwood",
}

test_module_config {
    name: "CtsAppTestCases_android_server_am_Presubmit",
    base: "CtsAppTestCases",
    test_suites: ["general-tests"],
    include_filters: [
        "android.app.cts.ActivityManagerProcessStateTest",
        "android.app.cts.ServiceTest",
        "android.app.cts.ActivityManagerTest",
        "android.app.cts.TaskDescriptionTest",
    ],
    include_annotations: ["android.platform.test.annotations.Presubmit"],
    exclude_annotations: ["androidx.test.filters.LargeTest"],
}

test_module_config {
    name: "CtsAppTestCases_android_server_am",
    base: "CtsAppTestCases",
    test_suites: ["general-tests"],
    include_filters: [
        "android.app.cts.ActivityManagerProcessStateTest",
        "android.app.cts.ServiceTest",
        "android.app.cts.ActivityManagerTest",
        "android.app.cts.TaskDescriptionTest",
    ],
}

test_module_config {
    name: "CtsAppTestCases_cts_activitymanagerapi29test",
    base: "CtsAppTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.app.cts.ActivityManagerApi29Test"],
}

test_module_config {
    name: "CtsAppTestCases_cts_requesttileserviceaddtest",
    base: "CtsAppTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.app.cts.RequestTileServiceAddTest"],
}

test_module_config {
    name: "CtsAppTestCases_cts_toolbaractionbartest",
    base: "CtsAppTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.app.cts.ToolbarActionBarTest"],
}

test_module_config {
    name: "CtsAppTestCases_all-except-large",
    base: "CtsAppTestCases",
    test_suites: ["general-tests"],
    exclude_filters: ["android.app.cts.ActivityManagerProcessStateTest"],
    exclude_annotations: ["androidx.test.filters.LargeTest"],
}

test_module_config {
    name: "CtsAppTestCases_activitymanagerprocessstatetest",
    base: "CtsAppTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.app.cts.ActivityManagerProcessStateTest"],
    exclude_annotations: ["androidx.test.filters.LargeTest"],
}
