package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test {
    name: "CtsAppFgsTestCases",
    team: "trendy_team_framework_bpm",
    defaults: ["cts_defaults"],
    libs: [
        "android.test.runner.stubs.system",
        "org.apache.http.legacy.stubs.system",
        "android.test.base.stubs.system",
    ],
    static_libs: [
        "androidx.test.uiautomator_uiautomator",
        "androidx.test.rules",
        "compatibility-device-util-axt",
        "CtsExternalServiceCommon",
        "cts_app_test_shared_lib",
        "cts-wm-util",
        "libprotobuf-java-lite",
        "permission-test-util-lib",
        "flag-junit",
        "android.content.pm.flags-aconfig-java",
        "com.android.media.flags.bettertogether-aconfig-java",
        "services.core",
    ],
    srcs: [
        "src/**/*.java",
        "app/src/**/*.aidl",
    ],
    test_suites: [
        "cts",
        "general-tests",
    ],
    instrumentation_for: "CtsAppTestFgsTestHelper",
    manifest: "AndroidManifest.xml",
    test_config: "AndroidTest.xml",
    platform_apis: true,
    data: [
        ":CtsAppTestStubsApp1",
        ":CtsAppTestStubsApp2",
        ":CtsAppTestStubsApp3",
        ":CtsAppTestFgsTestHelper",
        ":CtsAppTestFgsTestHelperCurrent",
        ":CtsAppTestFgsTestHelperApi33",
    ],
    per_testcase_directory: true,
}

test_module_config {
    name: "CtsAppFgsTestCases_pm_Presubmit",
    base: "CtsAppFgsTestCases",
    test_suites: ["general-tests"],
    include_annotations: ["android.platform.test.annotations.Presubmit"],
    exclude_annotations: ["androidx.test.filters.LargeTest"],
}
