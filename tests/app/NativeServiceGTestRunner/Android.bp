package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library_static {
    name: "libnative_service_gtest_runner",
    srcs: ["src/**/*.java"],
    static_libs: [
        "am_flags_lib",
        "android.os.flags-aconfig-java",
        "androidx.test.ext.junit",
        "androidx.test.runner",
        "junit",
        "platform-test-annotations",
        "libgtest_native_service_interface-java",
    ],
}

// Build target for the native service library
cc_library_shared {
    name: "libgtest_native_service",
    srcs: [
        "lib/GTestNativeService.cpp",
    ],
    header_libs: [
        "libbinder_headers",
    ],
    static_libs: [
        "libgtest_native_service_interface-ndk",
        "libgtest",
    ],
    shared_libs: [
        "libandroid",
        "libbinder_ndk",
        "liblog",
    ],
}

aidl_interface {
    name: "libgtest_native_service_interface",
    unstable: true,
    srcs: [
        "lib/**/*.aidl",
    ],
    local_include_dir: "lib/aidl",
    backend: {
        java: {
            platform_apis: false,
        },
        ndk: {
            enabled: true,
        },
    },
}
