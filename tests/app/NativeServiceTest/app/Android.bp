package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "cts_simple_native_service_aidl_interface",
    unstable: true,
    backend: {
        java: {
            platform_apis: false,
        },
        ndk: {
            enabled: true,
        },
    },
    srcs: [
        "aidl/**/*.aidl",
    ],
    local_include_dir: "aidl",
}

cc_library_shared {
    name: "libctssimplenativeservice",
    srcs: [
        "SimpleNativeService.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-missing-field-initializers",
        "-Wno-unused-variable",
    ],
    shared_libs: [
        "libandroid",
        "libbinder_ndk",
        "liblog",
    ],
    header_libs: [
        "liblog_headers",
    ],
    static_libs: [
        "cts_simple_native_service_aidl_interface-ndk",
    ],
    sdk_version: "current",
    stl: "c++_shared",
}
