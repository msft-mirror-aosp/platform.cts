<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="android.nativeservice.allowlist.cts"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="37" android:targetSdkVersion="37" />
    <application tools:ignore="MissingApplicationIcon">
        <uses-library android:name="android.test.runner" />
        <service android:name=".SimpleNativeService"
                 android:isolatedProcess="true"
                 android:nativeService="true"
                 android:allowSharedIsolatedProcess="false">
          <property android:name="android.app.PROPERTY_NATIVE_SERVICE_LIBRARY_NAME"
                     android:value="libctssimplenativeservice.so" />
        </service>
    </application>

    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="android.nativeservice.allowlist.cts"
        android:label="Integration tests for native services allowlist" />

</manifest>
