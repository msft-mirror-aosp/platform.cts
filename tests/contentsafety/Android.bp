package {
    // See: http://go/android-license-faq
    default_applicable_licenses: [
        "Android-Apache-2.0",
    ],
}

android_test {
    name: "CtsContentSafetyServiceTestCases",
    team: "trendy_team_content_safety",
    defaults: ["cts_defaults"],
    dex_preopt: {
        enabled: false,
    },
    optimize: {
        enabled: false,
    },
    platform_apis: true,
    sdk_version: "test_current",
    static_libs: [
        "androidx.test.rules",
        "androidx.test.ext.junit",
        "androidx.test.core",
        "compatibility-device-util-axt",
        "platform-test-annotations",
        "compatibility-device-util-axt",
        "cts-wm-util",
        "android.app.contentsafety-aconfig-java",
        "android-support-v4",
        "libprotobuf-java-nano",
        "android-common",
        "bedstead",
        "bedstead-flags",
    ],
    libs: [
        "android.test.base.stubs.system",
        "android.test.runner.stubs.system",
    ],
    srcs: [
        "src/**/*.java",
        "src/**/*.proto",
        "src/android/contentsafety/cts/ContentSafetyManagerTest.java",
        "src/android/contentsafety/cts/CtsContentSafetyPccService.java",
        "src/android/contentsafety/cts/CtsContentSafetyService.java",
        "src/android/contentsafety/cts/CtsContentSafetySettingsService.java",
    ],
    // Tag this module as a cts test artifact
    test_suites: [
        "cts",
        "general-tests",
    ],
}

team {
    name: "trendy_team_content_safety",

    // go/trendy/manage/engineers/6694284645728256
    trendy_team_id: "6694284645728256",
}
