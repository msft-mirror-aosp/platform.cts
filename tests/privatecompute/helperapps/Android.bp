package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Common defaults for the helper apps
java_defaults {
    name: "CtsPccHelperAppDefaults",
    sdk_version: "current",
    min_sdk_version: "34",
}

android_test_helper_app {
    name: "CtsPccAppWithFlagAndQueryable",
    defaults: ["CtsPccHelperAppDefaults"],
    manifest: "Manifest_AppWithFlagAndQueryable.xml",
}

android_test_helper_app {
    name: "CtsPccAppWithFlagNotQueryable",
    defaults: ["CtsPccHelperAppDefaults"],
    manifest: "Manifest_AppWithFlagNotQueryable.xml",
}

android_test_helper_app {
    name: "CtsPccAppWithoutFlagQueryable",
    defaults: ["CtsPccHelperAppDefaults"],
    manifest: "Manifest_AppWithoutFlagQueryable.xml",
}

android_test_helper_app {
    name: "CtsPccAppWithIntentAndPccFlag",
    defaults: ["CtsPccHelperAppDefaults"],
    manifest: "Manifest_AppWithIntentAndPccFlag.xml",
    srcs: ["src/**/*.java"],
}

android_test_helper_app {
    name: "CtsPccAppWithIntentNoPccFlag",
    defaults: ["CtsPccHelperAppDefaults"],
    manifest: "Manifest_AppWithIntentNoPccFlag.xml",
    srcs: ["src/**/*.java"],
}
