<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.cts.pcc.processes">

    <application>
        <uses-library android:name="android.test.runner" />
        <activity android:name=".BaseActivity$NonPccActivity" android:exported="false" />
        <activity android:name=".BaseActivity$PccActivity" android:exported="false"
            android:isPrivateComputeCoreProcess="true"/>
        <activity-alias android:name=".PccActivityAlias" android:exported="false"
            android:targetActivity=".BaseActivity$PccActivity"
            android:isPrivateComputeCoreProcess="true"/>

        <activity-alias android:name=".PccAliasForNonPccActivity" android:exported="false"
            android:targetActivity=".BaseActivity$NonPccActivity"
            android:isPrivateComputeCoreProcess="true"/>

        <activity android:name=".BaseActivity$PccSecondProcessActivity"
            android:exported="false"
            android:process=":pcc_second"
            android:isPrivateComputeCoreProcess="true"/>

        <service android:name="com.android.cts.pcc.processes.PccService"
            android:exported="false"
            android:isPrivateComputeCoreProcess="true"/>
        <receiver android:name=".PccBroadcastReceiver"
                android:exported="true" android:isPrivateComputeCoreProcess="true">
            <intent-filter>
                <action android:name="com.android.cts.pcc.processes.ACTION_TEST_BROADCAST" />
            </intent-filter>
        </receiver>
        <receiver android:name=".PccSecondProcessBroadcastReceiver"
                android:process=":pcc_second" android:exported="true" android:isPrivateComputeCoreProcess="true">
            <intent-filter>
                <action android:name="com.android.cts.pcc.processes.ACTION_TEST_BROADCAST_SECOND_PROCESS" />
            </intent-filter>
        </receiver>
        <provider
                android:name=".PccContentProvider"
                android:exported="false"
                android:authorities="com.android.cts.pcc.processes.provider" android:isPrivateComputeCoreProcess="true"/>
        <provider
                android:name=".PccSecondProcessContentProvider"
                android:exported="false"
                android:authorities="com.android.cts.pcc.processes.provider_second"
                android:process=":pcc_second" android:isPrivateComputeCoreProcess="true"/>
    </application>

    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="com.android.cts.pcc.processes"
        android:label="CTS tests for PCC processes" />
</manifest>
