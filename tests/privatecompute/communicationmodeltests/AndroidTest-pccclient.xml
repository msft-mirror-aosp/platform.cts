<configuration description="Config for CTS PCC Service test cases when client is in PCC sandbox">
    <object class="com.android.tradefed.testtype.suite.module.CommandSuccessModuleController"
        type="module_controller">
        <option name="run-command"
            value="aflags list | grep 'android.app.privatecompute.flags.enable_pcc_framework_support' | awk '{print $2}' | grep 'enabled'" />
    </object>
    <option name="test-suite-tag" value="cts" />
    <option name="test-tag" value="PccServicePccClientTest" />
    <option name="config-descriptor:metadata" key="component" value="framework" />
    <option name="config-descriptor:metadata" key="parameter" value="not_instant_app" />
    <option name="config-descriptor:metadata" key="parameter" value="multi_abi" />
    <option name="config-descriptor:metadata" key="parameter" value="secondary_user" />
    <option name="config-descriptor:metadata" key="parameter" value="no_foldable_states" />
    <target_preparer class="com.android.tradefed.targetprep.suite.SuiteApkInstaller">
        <option name="cleanup-apks" value="true" />
        <option name="test-file-name" value="PccServicePccClientTest.apk" />
    </target_preparer>
    <target_preparer class="com.android.tradefed.targetprep.RunCommandTargetPreparer">
        <option name="run-command" value="cmd pcc_sandbox add-allowed-package com.android.cts.pcc.service.pccclient" />
        <option name="teardown-command" value="cmd pcc_sandbox remove-allowed-package com.android.cts.pcc.service.pccclient" />
    </target_preparer>
    <test class="com.android.tradefed.testtype.AndroidJUnitTest">
        <option name="package" value="com.android.cts.pcc.service.pccclient" />
        <option name="runner" value="androidx.test.runner.AndroidJUnitRunner" />
        <option name="instrument-in-pcc" value="true" />
    </test>
</configuration>