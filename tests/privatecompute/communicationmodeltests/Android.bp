android_test {
    name: "PccServicePccClientTest",
    team: "trendy_team_private_compute_core",
    defaults: [
        "cts_defaults",
    ],
    srcs: [
        "src/com/android/cts/pcc/service/pccclient/**/*.java",
    ],
    sdk_version: "test_current",
    static_libs: [
        "pccservice-cts-test-common",
        "androidx.test.ext.junit",
        "androidx.test.runner",
        "frameworks-base-testutils",
        "flag-junit",
        "services.core",
        "android.app.privatecompute.flags-aconfig-java",
    ],
    test_suites: [
        "cts",
        "general-tests",
    ],
    manifest: "src/com/android/cts/pcc/service/pccclient/AndroidManifest.xml",
    test_config: "AndroidTest-pccclient.xml",
}

android_test {
    name: "PccServiceNonPccClientTest",
    team: "trendy_team_private_compute_core",
    defaults: [
        "cts_defaults",
    ],
    srcs: [
        "src/com/android/cts/pcc/service/nonpccclient/**/*.java",
    ],
    sdk_version: "test_current",
    static_libs: [
        "pccservice-cts-test-common",
        "androidx.test.ext.junit",
        "androidx.test.runner",
        "frameworks-base-testutils",
        "flag-junit",
        "services.core",
        "android.app.privatecompute.flags-aconfig-java",
    ],
    test_suites: [
        "cts",
        "general-tests",
    ],
    manifest: "src/com/android/cts/pcc/service/nonpccclient/AndroidManifest.xml",
    test_config: "AndroidTest-nonpccclient.xml",
    data: [
        ":PccServicePccClientTest",
    ],
}

java_library {
    name: "pccservice-cts-test-common",
    team: "trendy_team_private_compute_core",
    srcs: [
        "src/com/android/cts/pcc/service/common/**/*.java",
        "aidl/**/*.aidl",
    ],
    sdk_version: "test_current",
}
