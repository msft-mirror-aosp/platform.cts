package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_test_host {
    name: "CtsMediaRouterHostTestCases",
    team: "trendy_team_android_media_better_together",
    defaults: ["cts_defaults"],
    srcs: [
        "src/**/*.java",
    ],
    test_suites: [
        "cts",
        "general-tests",
    ],
    libs: [
        "cts-tradefed",
        "tradefed",
        "compatibility-host-util",
    ],
    static_libs: [
        "com.android.media.flags.bettertogether-aconfig-java-host",
        "CompatChangeGatingTestBase",
        "cts-host-utils",
        "device-policy-users-preparer",
        "CtsMediaRouterHostTestCommon",
        "flag-junit-host",
        "modules-utils-build-testing",
    ],
    device_common_data: [
        ":CtsMediaRouterHostSideTestBluetoothPermissionsApp",
        ":CtsMediaRouterHostSideTestModifyAudioRoutingApp",
        ":CtsMediaRouterHostSideTestMediaRoutingControlApp",
        ":CtsMediaRouterHostSideTestRequiredPermissionsApp",
        ":CtsMediaRouterHostSideTestProviderApp1",
        ":CtsMediaRouterHostSideTestProviderApp2",
        ":CtsMediaRouterHostSideTestProviderApp3",
        ":CtsMediaRouterHostSideTestProviderRequiresPermissionsApp",
        ":CtsMediaRouterHostSideTestProviderSelfScanOnlyApp",
        ":CtsMediaRouterHostSideTestProviderWithPackageManagerSpam",
        ":CtsMediaRouterHostSideTestProxyScanningTestApp",
        ":CtsProxyMediaRouterSecondaryUserTestHelperApp",
        ":CtsProxyMediaRouterTestHelperApp",
        ":CtsMediaRouterHostSideTestPerAppDiscoveryPrefsConsumer1",
        ":CtsMediaRouterHostSideTestPerAppDiscoveryPrefsConsumer2",
        ":CtsMediaRouterHostSideTestProviderPerApp",
        ":CtsMediaSessionCreatorApp",
        ":CtsMediaSessionOwnerApp",
    ],
    enable_static_aconfig_pb: true,
}
