package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_test_helper_app {
    name: "DelayedRestoreApp",
    defaults: ["cts_defaults"],
    srcs: ["DelayedRestoreApp/src/**/*.java"],
    manifest: "DelayedRestoreApp/AndroidManifest.xml",
    certificate: "platform",
    sdk_version: "system_current",
    static_libs: [
        "androidx.test.rules",
        "androidx.test.runner",
        "backup_flags_lib",
        "flag-junit",
        "platform-test-annotations",
        "truth",
    ],
}

android_test_helper_app {
    name: "DelayedFullRestoreApp",
    defaults: ["cts_defaults"],
    srcs: ["DelayedFullRestoreApp/src/**/*.java"],
    manifest: "DelayedFullRestoreApp/AndroidManifest.xml",
    certificate: "platform",
    sdk_version: "system_current",
    static_libs: [
        "androidx.test.rules",
        "androidx.test.runner",
        "platform-test-annotations",
        "truth",
    ],
}

android_test_helper_app {
    name: "DelayedRestoreDependencyApp",
    defaults: ["cts_defaults"],
    manifest: "DelayedRestoreDependencyApp/AndroidManifest.xml",
    sdk_version: "current",
}
