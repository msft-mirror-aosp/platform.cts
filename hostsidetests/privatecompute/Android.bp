package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_test_host {
    name: "PccStorageHostTest",
    srcs: [
        "src/**/PccStorageHostTest.java",
        ":CtsHostsideTestsAppSecurityUtil",
    ],
    team: "trendy_team_private_compute_core",
    test_config: "PccHostTest.xml",
    libs: [
        "tradefed",
        "junit",
        "cts-tradefed",
    ],
    static_libs: [
        "android.app.privatecompute.flags-aconfig-java",
        "cts-install-lib-host",
        "compatibility-host-util",
        "platform-test-annotations",
        "flag-junit-host",
        "modules-utils-build-testing",
    ],
    test_suites: [
        "general-tests",
    ],
    device_common_data: [
        ":PccHostTestApp",
        ":NonPccHostTestApp",
    ],
}

android_test_helper_app {
    name: "PccHostTestApp",
    srcs: [
        "apps/PccApp/**/*.java",
    ],
    manifest: "apps/PccApp/AndroidManifest.xml",
    min_sdk_version: "34",
}

android_test_helper_app {
    name: "NonPccHostTestApp",
    srcs: [
        "apps/NonPccApp/**/*.java",
    ],
    manifest: "apps/NonPccApp/AndroidManifest.xml",
    min_sdk_version: "34",
}
