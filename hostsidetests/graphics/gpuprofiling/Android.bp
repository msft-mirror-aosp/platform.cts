package {
    default_team: "trendy_team_android_gpu",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library_host {
    name: "GpuProfilingDataUtils",
    defaults: ["cts_defaults"],

    static_libs: [
        "perfetto_config-full",
        "perfetto_trace-full",
    ],

    srcs: [
        "src/**/ClockUtils.kt",
        "src/**/ProfilingDataUtils.kt",
    ],
}

java_test_host {
    name: "CtsGpuProfilingDataTestCases",
    srcs: [
        "src/**/CtsFrameTracerDataSourceTest.java",
        "src/**/CtsGpuProfilingDataTest.java",
    ],
    // tag this module as a cts test artifact
    test_suites: [
        "cts",
        "general-tests",
    ],
    libs: [
        "compatibility-host-util",
        "cts-tradefed",
        "tradefed",
    ],
    static_libs: [
        "GpuProfilingDataUtils",
        "hamcrest-library",
        "host-libprotobuf-java-full",
        "perfetto_config-full",
        "perfetto_trace-full",
        "platform-test-annotations-host",
    ],
    device_common_data: [
        ":CtsGraphicsProfilingDataApp",
    ],
    per_testcase_directory: true,
    test_config: "CtsGpuProfilingDataTestCases.xml",
}

// Unit tests for utilities used by the CTS tests - not CTS itself
java_test_host {
    name: "GpuProfilingUtilsTestCases",
    srcs: [
        "src/**/ClockUtilsTest.kt",
        "src/**/ProfilingDataUtilsTest.kt",
    ],
    static_libs: [
        "GpuProfilingDataUtils",
        "mockito-hostside-prebuilt",
        "perfetto_config-full",
        "perfetto_trace-full",
        "tradefed",
    ],
    test_suites: [
        "general-tests",
    ],
    test_config: "GpuProfilingUtilsTestCases.xml",
}
