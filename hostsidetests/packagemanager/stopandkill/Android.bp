package {
    default_team: "trendy_team_framework_android_packages",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "cts_stopandkill_testapp_defaults",
    defaults: ["cts_defaults"],
    sdk_version: "test_current",
    srcs: ["app/src/**/*.java"],
    static_libs: [
        "androidx.test.runner",
        "androidx.test.core",
        "ub-uiautomator",
        "truth",
    ],
    optimize: {
        enabled: false,
    },
    test_suites: ["device-tests"],
}

android_test_helper_app {
    name: "CtsStopAndKillTestApp1",
    defaults: ["cts_stopandkill_testapp_defaults"],
    manifest: "app/AndroidManifest.xml",
    package_name: "com.android.cts.stopandkillapp1",
}

android_test_helper_app {
    name: "CtsStopAndKillTestApp2",
    defaults: ["cts_stopandkill_testapp_defaults"],
    manifest: "app/AndroidManifest.xml",
    package_name: "com.android.cts.stopandkillapp2",
}

android_test_helper_app {
    name: "CtsStopAndKillTestApp3",
    defaults: ["cts_stopandkill_testapp_defaults"],
    manifest: "app/AndroidManifest.xml",
    package_name: "com.android.cts.stopandkillapp3",
}

java_test_host {
    name: "CtsStopAndKillHostTest",
    defaults: ["cts_defaults"],
    srcs: ["src/**/*.java"],
    test_suites: [
        "cts",
        "general-tests",
    ],
    device_common_data: [
        ":CtsStopAndKillTestApp1",
        ":CtsStopAndKillTestApp2",
        ":CtsStopAndKillTestApp3",
    ],
    libs: [
        "cts-tradefed",
        "tradefed",
        "compatibility-host-util",
        "truth",
    ],
    static_libs: [
        "com.android.internal.pm.pkg.component.flags-aconfig-java-host",
        "com.android.window.flags.window-aconfig-java-host",
        "cts-statsd-atom-host-test-utils",
        "flag-junit-host",
    ],
    enable_static_aconfig_pb: true,
}
