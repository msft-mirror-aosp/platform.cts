package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_test_host {
    name: "CtsPerformanceHintManagerAtomHostTestCases",
    team: "trendy_team_android_gpu",
    defaults: ["CtsStatsdAtomHostTest_defaults"],
    srcs: ["src/**/*.java"],
    static_libs: [
        "power_hint_flags_lib_host",
        "cts_adpf_atom_common-host",
        "cts_adpf_atom_common-host2",
    ],
    device_common_data: [
        ":CtsStatsdAdpfApp",
        ":CtsStatsdAdpfApp2",
    ],
    test_config: "AndroidTest.xml",
}

test_module_config_host {
    name: "CtsStatsdAtomHostTestCases_statsdatom_performancehintmanager",
    base: "CtsPerformanceHintManagerAtomHostTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.cts.statsdatom.performancehintmanager"],
}
