package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_test_host {
    name: "CtsJobSchedulerAtomHostTestCases",
    team: "trendy_team_orchestration_frameworks",
    defaults: ["CtsStatsdAtomHostTest_defaults"],
    srcs: ["src/**/*.java"],
    test_config: "AndroidTest.xml",
}

test_module_config_host {
    name: "CtsStatsdAtomHostTestCases_statsdatom_jobscheduler",
    base: "CtsJobSchedulerAtomHostTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.cts.statsdatom.jobscheduler"],
}
