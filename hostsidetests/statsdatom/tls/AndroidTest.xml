<configuration description="Config for CTS TLS statsd atom hostside tests">
    <option name="test-suite-tag" value="cts" />
    <option name="config-descriptor:metadata" key="component" value="statsd" />
    <option name="config-descriptor:metadata" key="module-name" value="CtsTlsAtomHostTestCases" />
    <option name="config-descriptor:metadata" key="token" value="SIM_CARD" />
    <option name="config-descriptor:metadata" key="parameter" value="instant_app" />
    <option name="config-descriptor:metadata" key="parameter" value="multi_abi" />
    <option name="config-descriptor:metadata" key="parameter" value="secondary_user" />
    <option name="config-descriptor:metadata" key="parameter" value="all_foldable_states" />
    <test class="com.android.compatibility.common.tradefed.testtype.JarHostTest" >
        <option name="jar" value="CtsTlsAtomHostTestCases.jar" />
    </test>

    <!-- disable GPP UI -->
    <target_preparer class="com.android.tradefed.targetprep.DeviceSetup">
        <option name="force-skip-system-props" value="true" />
        <option name="set-global-setting" key="verifier_engprod" value="1" />
        <option name="set-global-setting" key="verifier_verify_adb_installs" value="0" />
        <option name="restore-settings" value="true" />
    </target_preparer>

    <target_preparer class="com.android.tradefed.targetprep.RunCommandTargetPreparer">
        <!-- Disables StatsD logging control-->
        <option name="run-command" value="cmd stats logging-control 0" />
        <!-- Delay 30 seconds to allow StatsD process above command-->
        <option name="delay-after-commands" value="30000" />
        <option name="teardown-command" value="cmd stats logging-control 1" />
    </target_preparer>
</configuration>
