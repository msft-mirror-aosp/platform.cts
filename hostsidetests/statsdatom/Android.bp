package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "CtsStatsdAtomHostTest_defaults",
    defaults: ["cts_defaults"],
    test_suites: [
        "cts",
        "general-tests",
    ],
    libs: [
        "compatibility-host-util",
        "core_cts_test_resources",
        "cts-tradefed",
        "host-libprotobuf-java-full",
        "tradefed",
        "truth",
    ],
    static_libs: [
        "stats_flags_lib_host",
        "cts-statsd-atom-host-test-utils",
        "flag-junit-host",
        "truth-liteproto-extension",
        "truth-proto-extension",
    ],
    device_common_data: [
        ":CtsStatsdAtomApp",
    ],
    per_testcase_directory: true,
}

java_test_host {
    name: "CtsTelecomAtomHostTestCases",
    team: "trendy_team_fwk_telecom",
    defaults: ["CtsStatsdAtomHostTest_defaults"],
    srcs: [
        "telecom/src/**/*.java",
    ],
    device_common_data: [
        ":CtsTelecomTestCases",
        ":CtsTelecomCujTestCases",
        ":TransactionalVoipAppMain",
        ":ManagedConnectionServiceApp",
    ],
    test_config: "configs/AndroidTestTelecom.xml",
}

java_test_host {
    name: "CtsAppcompatStateAtomHostTestCases",
    team: "trendy_team_android_telemetry_client_infra",
    defaults: ["CtsStatsdAtomHostTest_defaults"],
    srcs: [
        "appcompatstate/src/**/*.java",
    ],
    device_common_data: [
        ":CtsPropertyCompatAllowUserAspectRatioOverrideOptInApp",
    ],
    test_config: "configs/AndroidTestAppcompatState.xml",
}

java_test_host {
    name: "CtsStatsdAtomHostTestCases",
    team: "trendy_team_android_telemetry_client_infra",
    defaults: ["CtsStatsdAtomHostTest_defaults"],
    srcs: [
        "alarm/src/**/*.java",
        "appfunctions/src/**/*.java",
        "apphibernation/src/**/*.java",
        "appops/src/**/*.java",
        "appexit/src/**/*.java",
        "appstart/src/**/*.java",
        "backportedfixes/src/**/*.java",
        "batterycycle/src/**/*.java",
        "batterystats/src/**/*.java",
        "bluetooth/src/**/*.java",
        "coregraphics/src/**/*.java",
        "cpu/src/**/*.java",
        "credentials/src/**/*.java",
        "devicepower/src/**/*.java",
        "devicestate/src/**/*.java",
        "display/src/**/*.java",
        "gamemanager/src/**/*.java",
        "gnss/src/**/*.java",
        "jobscheduler/src/**/*.java",
        "media/src/**/*.java",
        "memory/src/**/*.java",
        "net/src/**/*.java",
        "notification/src/**/*.java",
        "perf/src/**/*.java",
        "perfetto/src/**/*.java",
        "performancehintmanager/src/**/*.java",
        "permissionstate/src/**/*.java",
        "powermanager/src/**/*.java",
        "power/src/**/*.java",
        "settingsstats/src/**/*.java",
        "sizecompatrestartbutton/src/**/*.java",
        "statsd/src/**/*.java",
        "telephony/src/**/*.java",
        "tls/src/**/*.java",
        "usb/src/**/*.java",
        "users/src/**/*.java",
        "vibrator/src/**/*.java",
        "voiceinteraction/src/**/*.java",
        "wifi/src/**/*.java",
        "memorysafety/src/**/*.java",
        "express/src/**/*.java",
    ],

    test_suites: [
        "mts-uprobestats",
    ],

    static_libs: [
        "android.app.appfunctions.flags-aconfig-java-host",
        "android.hardware.usb.flags-aconfig-java-host",
        "android.os.flags-aconfig-java-host",
        "android.os.vibrator.flags-aconfig-java-host",
        "android.permission.flags-aconfig-java-host",
        "power_flags_lib_host",
        "display_flags_lib_host",
        "backstage_power_flags_lib-host",
        "power_hint_flags_lib_host",
        "uprobestats_mainline_flags_java_lib_test_host",
        "perfetto_config-full",
        "cts_adpf_atom_common-host",
        "cts_adpf_atom_common-host2",
        "uprobestats-protos",
    ],

    device_common_data: [
        ":CtsAppExitTestCases",
        ":CtsStatsdAdpfApp",
        ":CtsStatsdAdpfApp2",
        ":CtsExternalServiceService",
        ":CtsMediaProjectionTestCases",
        ":CtsDisplayTestCases",
        ":CtsPropertyCompatAllowUserAspectRatioOverrideOptInApp",
        ":CtsSimpleApp",
        ":CtsStatsdAlarmHelper",
        ":CtsStatsdAlarmHelper2",
        ":CtsVoiceInteractionTestCases",
        ":CtsCredentialManagerTestCases",
        ":CtsStatsdExpressLogHelper",
        ":CtsAppFunctionTestCases",
        ":CtsAppFunctionsTestHelper",
        ":CtsAppFunctionsSidecarTestHelper",
        ":ManagedConnectionServiceApp",
        ":TransactionalVoipAppMain",
    ],
}

java_library_host {
    name: "cts-statsd-atom-host-test-utils",
    srcs: ["lib/src/**/*.java"],
    static_libs: [
        "platformprotos",
        "host-libprotobuf-java-full",
    ],
    libs: [
        "compatibility-host-util",
        "cts-tradefed",
        "tradefed",
        "truth",
    ],
}

test_module_config_host {
    name: "CtsStatsdAtomHostTestCases_statsdatom_voiceinteraction",
    base: "CtsStatsdAtomHostTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.cts.statsdatom.voiceinteraction"],
}

test_module_config_host {
    name: "CtsStatsdAtomHostTestCases_statsdatom_jobscheduler",
    base: "CtsStatsdAtomHostTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.cts.statsdatom.jobscheduler"],
}

test_module_config_host {
    name: "CtsStatsdAtomHostTestCases_appexit_appexithosttest",
    base: "CtsStatsdAtomHostTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.cts.statsdatom.appexit.AppExitHostTest"],
    exclude_annotations: ["androidx.test.filters.LargeTest"],
}

test_module_config_host {
    name: "CtsStatsdAtomHostTestCases_statsdatom_gamemanager",
    base: "CtsStatsdAtomHostTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.cts.statsdatom.gamemanager"],
}

test_module_config_host {
    name: "CtsStatsdAtomHostTestCases_statsdatom_powermanager",
    base: "CtsStatsdAtomHostTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.cts.statsdatom.powermanager"],
}

test_module_config_host {
    name: "CtsStatsdAtomHostTestCases_statsdatom_performancehintmanager",
    base: "CtsStatsdAtomHostTestCases",
    test_suites: ["general-tests"],
    include_filters: ["android.cts.statsdatom.performancehintmanager"],
}

test_module_config_host {
    name: "CtsStatsdAtomHostTestCases-kernel-presubmit-brightness",
    base: "CtsStatsdAtomHostTestCases",
    test_suites: ["general-tests"],
    include_filters: [
        "android.cts.statsdatom.display.DisplayBrightnessChangedStatsTests",
        "android.cts.statsdatom.statsd.UidAtomTests#testScreenBrightness",
        "android.cts.statsdatom.display.DisplayWakeReportedStatsTests",
    ],
}
