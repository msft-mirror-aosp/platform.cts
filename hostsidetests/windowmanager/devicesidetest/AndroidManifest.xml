<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.android.cts.windowmanager.deviceside.test">
    <application />
    <!-- The target package isn't the application because that makes the activity run in the same
         instrumentation process. AMS terminates the instrumentation process at the end of tests,
         consequently killing the activities as well. That interrupts normal activity lifecycles,
         interfering tests on system behaviors on normal activities. -->
    <instrumentation android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="com.android.cts.windowmanager.deviceside.test"
        android:label="Device side tests of host side window manager tests" />
</manifest>
